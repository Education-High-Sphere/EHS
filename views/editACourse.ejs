<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Curso</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="../styles/createACourse.css"> 
</head>
<body>

    <div class="form-container">
        <div style="margin-bottom: 20px;">
            <a href="/teacherScene" class="btn-back">
                <i class="fas fa-arrow-left"></i> Voltar para o Painel
            </a>
        </div>
        <h2>Editar Curso: <%= course.nome %></h2> 
        
        <!-- Formulário de Metadados -->
        <form id="edit-course-form" enctype="multipart/form-data" data-course-id="<%= course.id %>">
            <div class="form-group full-width">
                <label for="nome">Título do Curso</label>
                <input type="text" id="nome" name="nome" placeholder="Ex: Python para Análise de Dados" value="<%= course.nome %>" required>
            </div>

            <div class="form-group full-width">
                <label for="descricao">Descrição</label>
                <textarea id="descricao" name="descricao" rows="5" placeholder="Aprenda a manipular, analisar e visualizar dados com..." required><%= course.descricao %></textarea>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label for="categoria">Categoria</label>
                    <select id="categoria" name="categoria" required>
                        <option value="" disabled>Selecione uma categoria</option>
                        <option value="Tecnologia" <%= course.categoria === 'Tecnologia' ? 'selected' : '' %>>Tecnologia</option>
                        <option value="Negócios" <%= course.categoria === 'Negócios' ? 'selected' : '' %>>Negócios</option>
                        <option value="Design" <%= course.categoria === 'Design' ? 'selected' : '' %>>Design</option>
                        <option value="Marketing" <%= course.categoria === 'Marketing' ? 'selected' : '' %>>Marketing</option>
                        <option value="Outra" <%= course.categoria === 'Outra' ? 'selected' : '' %>>Outra</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="nivel">Nível</label>
                    <select id="nivel" name="nivel" required>
                        <option value="" disabled>Selecione o nível</option>
                        <option value="Iniciante" <%= course.nivel === 'Iniciante' ? 'selected' : '' %>>Iniciante</option>
                        <option value="Intermediário" <%= course.nivel === 'Intermediário' ? 'selected' : '' %>>Intermediário</option>
                        <option value="Avançado" <%= course.nivel === 'Avançado' ? 'selected' : '' %>>Avançado</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="preco">Preço (R$)</label>
                    <input type="number" id="preco" name="preco" min="0" step="0.01" placeholder="Ex: 179.90" value="<%= course.preco %>" required>
                </div>

                <div class="form-group">
                    <label for="duracao">Duração</label>
                    <input type="text" id="duracao" name="duracao" placeholder="Ex: 30 horas" value="<%= course.duracao %>" required>
                </div>
            </div> 
            
            <div class="form-group full-width">
                <label>Imagem da Capa</label>
                <div class="file-drop-area" id="file-drop-area">
                    <i class="fas fa-upload"></i>
                    <p>Arraste e solte a imagem aqui, ou clique para selecionar</p>
                    <input type="file" id="imagem" name="imagem" accept="image/*"> 
                </div>
                <img id="image-preview" src="<%= course.imagem || '#' %>" alt="Preview da Imagem" style="<%= course.imagem ? 'display: block;' : 'display: none;' %>" />
            </div>

            <div class="form-group full-width">
                <div class="publish-container">
                    <label>Status do Curso</label>
                    <div class="publish-switch">
                        <span class="switch-label"><%= course.publicated ? 'Publicado' : 'Rascunho' %></span>
                        <label class="switch">
                            <input type="checkbox" id="publicated-toggle" name="publicated" value="true" <%= course.publicated ? 'checked' : '' %>>
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <button type="submit" class="submit-btn">Salvar Alterações Gerais</button>
        </form>

        <hr style="margin: 40px 0; border: 0; border-top: 1px solid #ddd;">

        <!-- Seção de Conteúdo do Curso (Módulos e Aulas) -->
        <div class="content-management">
            <h3>Conteúdo do Curso</h3>
            <p>Gerencie os módulos e as aulas do seu curso.</p>

            <div id="modules-container">
                <% content.forEach((module, mIdx) => { %>
                    <div class="module-item" data-id="<%= module.id %>">
                        <div class="module-header" onclick="toggleModule(this)">
                            <div class="module-title">
                                <i class="fas fa-chevron-right"></i>
                                <span>Módulo <%= mIdx + 1 %>: <%= module.titulo %></span>
                            </div>
                            <div class="module-actions">
                                <button class="icon-btn" onclick="editModule('<%= module.id %>', '<%= module.titulo %>')"><i class="fas fa-edit"></i></button>
                                <button class="icon-btn delete" onclick="deleteModule('<%= module.id %>')"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        <div class="module-content hidden">
                            <ul class="lessons-list">
                                <% if (module.lessons && module.lessons.length > 0) { %>
                                    <% module.lessons.sort((a,b) => a.ordem - b.ordem).forEach((lesson, lIdx) => { %>
                                        <li class="lesson-item" data-id="<%= lesson.id %>">
                                            <div class="lesson-info">
                                                <i class="fas fa-play-circle"></i>
                                                <span><%= lIdx + 1 %>. <%= lesson.titulo %></span>
                                            </div>
                                            <div class="lesson-actions">
                                                <button class="icon-btn" onclick="editLesson('<%= lesson.id %>', '<%= module.id %>')"><i class="fas fa-edit"></i></button>
                                                <button class="icon-btn delete" onclick="deleteLesson('<%= lesson.id %>')"><i class="fas fa-trash"></i></button>
                                            </div>
                                        </li>
                                    <% }) %>
                                <% } else { %>
                                    <li class="empty-lessons">Nenhuma aula neste módulo.</li>
                                <% } %>
                            </ul>
                            <button class="add-lesson-btn" onclick="openAddLessonModal('<%= module.id %>')">
                                <i class="fas fa-plus"></i> Adicionar Aula
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>

            <button class="add-module-btn" onclick="openAddModuleModal()">
                <i class="fas fa-folder-plus"></i> Adicionar Novo Módulo
            </button>
        </div>
    </div>

    <!-- Modais -->
    <!-- Loading Overlay -->
    <div id="loading-overlay" style="display:none; position:fixed; inset:0; background:rgba(27,34,50,0.85); z-index:9999; display:none; align-items:center; justify-content:center; backdrop-filter:blur(4px);">
        <div style="text-align:center; color:#f4f4f4;">
            <div class="page-spinner"></div>
            <p id="loading-text" style="margin-top:16px; font-size:1.1rem; font-weight:500;">Processando...</p>
        </div>
    </div>

    <div id="modal-overlay" class="modal-overlay hidden" onclick="closeModals()"></div>

    <!-- Modal Módulo -->
    <div id="module-modal" class="modal hidden">
        <h4 id="module-modal-title">Adicionar Módulo</h4>
        <input type="text" id="module-input-title" placeholder="Título do Módulo">
        <div class="modal-buttons">
            <button class="btn-cancel" onclick="closeModals()">Cancelar</button>
            <button class="btn-save" id="btn-save-module">Salvar</button>
        </div>
    </div>

    <!-- Modal Aula -->
    <div id="lesson-modal" class="modal hidden">
        <h4 id="lesson-modal-title">Adicionar Aula</h4>
        <input type="text" id="lesson-input-title" placeholder="Título da Aula">
        <textarea id="lesson-input-desc" placeholder="Descrição da aula"></textarea>
        <input type="text" id="lesson-input-url" placeholder="URL do Vídeo (YouTube/Vimeo)">
        <div class="file-input-group">
            <label>Ou faça upload do vídeo:</label>
            <input type="file" id="lesson-input-file" accept="video/*">
        </div>
        <div class="modal-buttons">
            <button class="btn-cancel" onclick="closeModals()">Cancelar</button>
            <button class="btn-save" id="btn-save-lesson">Salvar</button>
        </div>
    </div>

    <style>
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--cor-texto-principal);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 8px 16px;
            border-radius: 6px;
            border: 1px solid var(--cor-acento-azul);
            background-color: transparent;
            transition: all 0.2s ease;
        }
        .btn-back:hover {
            background-color: var(--cor-acento-azul);
            color: #fff;
            transform: translateX(-4px);
        }
        /* Estilos básicos para o gerenciamento de conteúdo */
        .content-management { margin-top: 20px; }
        .module-item { border: 1px solid #ddd; border-radius: 8px; margin-bottom: 10px; background: #fff; color: #1b2232; overflow: hidden; }
        .module-header { padding: 15px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: #f8f9fa; }
        .module-header:hover { background: #e9ecef; }
        .module-title { display: flex; align-items: center; gap: 10px; font-weight: 600; }
        .module-header.active i.fa-chevron-right { transform: rotate(90deg); }
        .module-content { padding: 15px; border-top: 1px solid #eee; }
        .lessons-list { list-style: none; margin-bottom: 10px; }
        .lesson-item { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px dotted #ccc; }
        .lesson-item:last-child { border-bottom: none; }
        .icon-btn { background: none; border: none; cursor: pointer; color: #666; padding: 5px; }
        .icon-btn:hover { color: var(--cor-acento); }
        .icon-btn.delete:hover { color: #e74c3c; }
        .add-lesson-btn, .add-module-btn { width: 100%; padding: 10px; border: 2px dashed #ccc; border-radius: 8px; background: none; cursor: pointer; color: #666; font-weight: 600; transition: 0.3s; }
        .add-lesson-btn:hover, .add-module-btn:hover { border-color: var(--cor-acento); color: var(--cor-acento); background: rgba(74, 120, 166, 0.05); }
        .add-module-btn { margin-top: 15px; border-color: var(--cor-acento); color: var(--cor-acento); }

        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; }
        .modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #fff; color: #1b2232; padding: 25px; border-radius: 12px; z-index: 1001; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        .modal h4 { color: #1b2232; margin-bottom: 15px; font-size: 1.2rem; }
        .modal input, .modal textarea { width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 6px; background: #f9f9f9; color: #333; }
        .modal input::placeholder, .modal textarea::placeholder { color: #999; }
        .modal-buttons { display: flex; justify-content: flex-end; gap: 10px; }
        .btn-cancel { padding: 8px 16px; border-radius: 6px; background: #eee; color: #333; border: none; cursor: pointer; font-weight: 500; }
        .btn-save { padding: 8px 16px; border-radius: 6px; background: var(--cor-acento-azul); color: #fff; border: none; cursor: pointer; font-weight: 500; }
        .hidden { display: none !important; }
        .file-input-group { margin-bottom: 15px; font-size: 14px; }

        /* Spinner Styles */
        .page-spinner {
            width: 48px;
            height: 48px;
            border: 4px solid rgba(74, 120, 166, 0.3);
            border-top-color: #4a78a6;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            margin: 0 auto;
        }
        .btn-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            vertical-align: middle;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .submit-btn:disabled, .btn-save:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
    </style>

    <script>
        // --- Helpers de Loading ---
        function showLoading(msg) {
            const el = document.getElementById('loading-overlay');
            document.getElementById('loading-text').textContent = msg || 'Processando...';
            el.style.display = 'flex';
        }
        function hideLoading() {
            document.getElementById('loading-overlay').style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', () => {
            const dropArea = document.getElementById('file-drop-area');
            const fileInput = document.getElementById('imagem');
            const imagePreview = document.getElementById('image-preview');
            const form = document.getElementById('edit-course-form'); 
            const courseId = form.dataset.courseId;
            const submitBtn = form.querySelector('.submit-btn');
            const originalBtnText = submitBtn.innerHTML;

            // Preview de Imagem
            function showPreview(file) {
                if (file && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        imagePreview.src = e.target.result;
                        imagePreview.style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                }
            }

            fileInput.addEventListener('change', (e) => {
                if (fileInput.files.length > 0) showPreview(fileInput.files[0]);
            });

            // Drag & Drop
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => dropArea.addEventListener(ev, e => { e.preventDefault(); e.stopPropagation(); }));
            ['dragenter', 'dragover'].forEach(ev => dropArea.addEventListener(ev, () => dropArea.classList.add('dragover')));
            ['dragleave', 'drop'].forEach(ev => dropArea.addEventListener(ev, () => dropArea.classList.remove('dragover')));
            dropArea.addEventListener('drop', (e) => {
                if (e.dataTransfer.files.length > 0) {
                    fileInput.files = e.dataTransfer.files;
                    showPreview(fileInput.files[0]);
                }
            });

            // Switch Label
            const publishToggle = document.getElementById('publicated-toggle');
            const switchLabel = document.querySelector('.publish-switch .switch-label');
            publishToggle.addEventListener('change', (e) => switchLabel.textContent = e.target.checked ? 'Publicado' : 'Rascunho');
            
            // Envio do Formulário Principal
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="btn-spinner"></span> Salvando...';
                const formData = new FormData(form);
                fetch(`/api/cursos/${courseId}`, { method: 'PUT', body: formData })
                .then(res => res.json())
                .then(data => {
                    submitBtn.innerHTML = '✓ Salvo com sucesso!';
                    submitBtn.style.backgroundColor = '#2ecc71';
                    setTimeout(() => window.location.reload(), 1000);
                })
                .catch(err => {
                    alert('Erro ao atualizar curso.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                });
            });
        });

        // --- Lógica de Módulos e Aulas ---
        function toggleModule(header) {
            header.classList.toggle('active');
            header.nextElementSibling.classList.toggle('hidden');
        }

        const overlay = document.getElementById('modal-overlay');
        const modModal = document.getElementById('module-modal');
        const lessonModal = document.getElementById('lesson-modal');
        let currentModuleId = null;
        let currentLessonId = null;

        function closeModals() {
            overlay.classList.add('hidden');
            modModal.classList.add('hidden');
            lessonModal.classList.add('hidden');
            currentModuleId = null;
            currentLessonId = null;
        }

        // Módulos
        function openAddModuleModal() {
            document.getElementById('module-modal-title').textContent = "Adicionar Módulo";
            document.getElementById('module-input-title').value = "";
            overlay.classList.remove('hidden');
            modModal.classList.remove('hidden');
        }

        function editModule(id, titulo) {
            currentModuleId = id;
            document.getElementById('module-modal-title').textContent = "Editar Módulo";
            document.getElementById('module-input-title').value = titulo;
            overlay.classList.remove('hidden');
            modModal.classList.remove('hidden');
        }

        document.getElementById('btn-save-module').onclick = async () => {
            const titulo = document.getElementById('module-input-title').value;
            const courseId = document.getElementById('edit-course-form').dataset.courseId;
            
            if (!titulo) return alert('Título obrigatório');

            const btn = document.getElementById('btn-save-module');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span> Salvando...';

            const url = currentModuleId ? `/api/content/modules/${currentModuleId}` : `/api/content/${courseId}/modules`;
            const method = currentModuleId ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ titulo })
                });
                if (res.ok) window.location.reload();
                else {
                    alert('Erro ao salvar módulo');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        };

        async function deleteModule(id) {
            if (!confirm('Tem certeza que deseja excluir este módulo e todas as suas aulas?')) return;
            showLoading('Excluindo módulo...');
            try {
                const res = await fetch(`/api/content/modules/${id}`, { method: 'DELETE' });
                if (res.ok) window.location.reload();
                else { hideLoading(); alert('Erro ao excluir módulo'); }
            } catch (err) { hideLoading(); console.error(err); }
        }

        // Aulas
        function openAddLessonModal(moduleId) {
            currentModuleId = moduleId;
            document.getElementById('lesson-modal-title').textContent = "Adicionar Aula";
            document.getElementById('lesson-input-title').value = "";
            document.getElementById('lesson-input-desc').value = "";
            document.getElementById('lesson-input-url').value = "";
            document.getElementById('lesson-input-file').value = "";
            overlay.classList.remove('hidden');
            lessonModal.classList.remove('hidden');
        }

        async function editLesson(lessonId, moduleId) {
            currentLessonId = lessonId;
            currentModuleId = moduleId;
            // Buscar dados da aula
            try {
                const res = await fetch(`/api/cursos/lessons/${lessonId}`); // TODO: Create this endpoint or find existing
                const lesson = await res.json();
                document.getElementById('lesson-modal-title').textContent = "Editar Aula";
                document.getElementById('lesson-input-title').value = lesson.titulo;
                document.getElementById('lesson-input-desc').value = lesson.descricao || "";
                document.getElementById('lesson-input-url').value = lesson.url_recurso || "";
                overlay.classList.remove('hidden');
                lessonModal.classList.remove('hidden');
            } catch (err) { 
                // Fallback se o endpoint não existir: apenas abre o modal vazio para edição parcial
                document.getElementById('lesson-modal-title').textContent = "Editar Aula";
                overlay.classList.remove('hidden');
                lessonModal.classList.remove('hidden');
            }
        }

        document.getElementById('btn-save-lesson').onclick = async () => {
            const titulo = document.getElementById('lesson-input-title').value;
            const descricao = document.getElementById('lesson-input-desc').value;
            const video_url = document.getElementById('lesson-input-url').value;
            const file = document.getElementById('lesson-input-file').files[0];

            if (!titulo) return alert('Título obrigatório');

            const btn = document.getElementById('btn-save-lesson');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span> Salvando...';

            const formData = new FormData();
            formData.append('titulo', titulo);
            formData.append('descricao', descricao);
            formData.append('video_url', video_url);
            if (file) formData.append('video', file);

            const url = currentLessonId ? `/api/content/lessons/${currentLessonId}` : `/api/content/modules/${currentModuleId}/lessons`;
            const method = currentLessonId ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, { method, body: formData });
                if (res.ok) window.location.reload();
                else {
                    alert('Erro ao salvar aula');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        };

        async function deleteLesson(id) {
            if (!confirm('Tem certeza que deseja excluir esta aula?')) return;
            showLoading('Excluindo aula...');
            try {
                const res = await fetch(`/api/content/lessons/${id}`, { method: 'DELETE' });
                if (res.ok) window.location.reload();
                else { hideLoading(); alert('Erro ao excluir aula'); }
            } catch (err) { hideLoading(); console.error(err); }
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const dropArea = document.getElementById('file-drop-area');
            const fileInput = document.getElementById('imagem');
            const imagePreview = document.getElementById('image-preview');
            const form = document.getElementById('edit-course-form'); 
            const courseId = form.dataset.courseId; 

            // --- 1. Lógica do Preview de Imagem (igual ao de criação) ---
            function showPreview(file) {
                if (file && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        imagePreview.src = e.target.result;
                        imagePreview.style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                }
            }

            fileInput.addEventListener('change', (e) => {
                if (fileInput.files.length > 0) {
                    showPreview(fileInput.files[0]);
                } else if (!imagePreview.src || imagePreview.src === window.location.href + '#') {
                    // Se nenhum arquivo novo foi selecionado e não havia imagem anterior, esconde o preview
                    imagePreview.style.display = 'none';
                }
            });

            // --- 2. Lógica do Drag & Drop (igual ao de criação) ---
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropArea.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                }, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                dropArea.addEventListener(eventName, () => {
                    dropArea.classList.add('dragover');
                }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                dropArea.addEventListener(eventName, () => {
                    dropArea.classList.remove('dragover');
                }, false);
            });
            dropArea.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length > 0) {
                    fileInput.files = files;
                    showPreview(files[0]);
                }
            }, false);

            // --- 3. Lógica do Switch Label (igual ao de criação) ---
            const publishToggle = document.getElementById('publicated-toggle');
            const switchLabel = document.querySelector('.publish-switch .switch-label');

            publishToggle.addEventListener('change', (e) => {
                switchLabel.textContent = e.target.checked ? 'Publicado' : 'Rascunho';
            });
            
            // --- 4. Lógica de ENVIO do Formulário (AGORA PARA EDIÇÃO) ---
            const submitBtn2 = form.querySelector('.submit-btn');
            const originalBtn2Text = submitBtn2 ? submitBtn2.innerHTML : '';

            form.addEventListener('submit', (e) => {
                e.preventDefault();

                if (submitBtn2) {
                    submitBtn2.disabled = true;
                    submitBtn2.innerHTML = '<span class="btn-spinner"></span> Salvando...';
                }

                const formData = new FormData(form);

                console.log('--- Formulário de EDIÇÃO pronto para enviar ---');
                for (let [key, value] of formData.entries()) {
                    console.log(`${key}:`, value);
                }
                
                fetch(`/api/cursos/${courseId}`, {
                    method: 'PUT',
                    body: formData 
                })
                .then(response => response.json())
                .then(data => {
                    console.log('Sucesso:', data);
                    if (submitBtn2) {
                        submitBtn2.innerHTML = '✓ Salvo com sucesso!';
                        submitBtn2.style.backgroundColor = '#2ecc71';
                    }
                    setTimeout(() => { window.location.href = '/teacherScene'; }, 1000);
                })
                .catch(error => {
                    console.error('Erro:', error);
                    alert('Erro ao atualizar curso.');
                    if (submitBtn2) {
                        submitBtn2.disabled = false;
                        submitBtn2.innerHTML = originalBtn2Text;
                    }
                });
            });

        });
    </script>

</body>
</html>