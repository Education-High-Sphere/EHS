<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLesson ? currentLesson.titulo : 'Assistir Aula' %> - <%= course.nome %></title>
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/watchCourse.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <%- include('common/header'); %>

    <main class="watch-container">
        
        <button id="mobile-sidebar-toggle" class="btn btn-secondary mobile-only">
            <i class="fas fa-list"></i> Ver Aulas
        </button>

        <!-- Sidebar de Conteúdo -->
        <aside class="course-sidebar" id="course-sidebar">
            <div class="sidebar-header">
                <h3>Conteúdo do Curso</h3>
                <div class="overall-progress">
                    <div class="progress-info">
                        <span>Seu progresso</span>
                        <span><%= Math.round(progress) %>%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: <%= progress %>%"></div>
                    </div>
                </div>
            </div>

            <div class="modules-list">
                <% content.forEach((module, mIndex) => { %>
                    <div class="module-item">
                        <div class="module-title" onclick="toggleModule(<%= mIndex %>)">
                            <span>Módulo <%= mIndex + 1 %>: <%= module.titulo %></span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </div>
                        <div class="lessons-list" id="module-<%= mIndex %>">
                            <% if (module.lessions && module.lessions.length > 0) { %>
                                <% module.lessions.forEach(lesson => { %>
                                    <a href="/watch/<%= course.id %>/<%= lesson.id %>" 
                                       class="lesson-link <%= currentLesson && currentLesson.id === lesson.id ? 'active' : '' %>">
                                        <div class="lesson-status">
                                            <% if (completedLessons.includes(lesson.id)) { %>
                                                <i class="fa-solid fa-circle-check completed"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-circle"></i>
                                            <% } %>
                                        </div>
                                        <span class="lesson-name"><%= lesson.titulo %></span>
                                    </a>
                                <% }); %>
                            <% } else { %>
                                <div class="empty-lessons">Nenhuma aula.</div>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        </aside>

        <!-- Área do Player -->
        <section class="video-area">
            <% if (currentLesson) { %>
                <div class="video-player-wrapper">
                    <% if (currentLesson.tipo === 'pdf') { %>
                        <div class="pdf-viewer">
                            <iframe src="<%= currentLesson.url_recurso %>" width="100%" height="600px"></iframe>
                            <p><a href="<%= currentLesson.url_recurso %>" target="_blank" class="btn-download"><i class="fas fa-download"></i> Baixar PDF</a></p>
                        </div>
                    <% } else if (currentLesson.tipo === 'slide') { %>
                        <div class="slide-viewer">
                            <% if (currentLesson.url_recurso.includes('docs.google.com')) { %>
                                <iframe src="<%= currentLesson.url_recurso %>/embed" frameborder="0" width="100%" height="500px" allowfullscreen="true"></iframe>
                            <% } else { %>
                                <iframe src="<%= currentLesson.url_recurso %>" frameborder="0" width="100%" height="500px" allowfullscreen="true"></iframe>
                            <% } %>
                        </div>
                    <% } else if (currentLesson.url_recurso && (currentLesson.url_recurso.includes('youtube.com') || currentLesson.url_recurso.includes('youtu.be'))) { %>
                        <% 
                            let videoId = '';
                            if (currentLesson.url_recurso.includes('v=')) {
                                videoId = currentLesson.url_recurso.split('v=')[1].split('&')[0];
                            } else {
                                videoId = currentLesson.url_recurso.split('/').pop();
                            }
                            let youtubeSrc = `https://www.youtube.com/embed/${videoId}`;
                            youtubeSrc += youtubeSrc.includes('?') ? '&enablejsapi=1' : '?enablejsapi=1';
                        %>
                        <iframe 
                            id="youtube-player"
                            src="<%= youtubeSrc %>" 
                            frameborder="0" allowfullscreen></iframe>
                    <% } else if (currentLesson.url_recurso && currentLesson.url_recurso.includes('vimeo.com')) { %>
                        <% let videoId = currentLesson.url_recurso.split('/').pop(); %>
                        <iframe 
                            id="vimeo-player"
                            src="https://player.vimeo.com/video/<%= videoId %>" 
                            frameborder="0" allowfullscreen></iframe>
                    <% } else if (currentLesson.url_recurso) { %>
                        <video id="html5-player" controls src="<%= currentLesson.url_recurso %>"></video>
                    <% } else { %>
                        <div class="no-video">
                            <i class="fa-solid fa-video-slash"></i>
                            <p>Vídeo não disponível para esta aula.</p>
                        </div>
                    <% } %>
                </div>

                <div class="lesson-details">
                    <div class="lesson-header">
                        <h2><%= currentLesson.titulo %></h2>
                        <button id="complete-btn" class="btn-complete <%= completedLessons.includes(currentLesson.id) ? 'completed' : 'locked' %>" 
                            <% if (!completedLessons.includes(currentLesson.id)) { %> disabled <% } %>>
                            <% if (completedLessons.includes(currentLesson.id)) { %>
                                <i class="fa-solid fa-check"></i> Concluída
                            <% } else { %>
                                <i class="fa-solid fa-lock" id="lock-icon"></i> Assista até o fim para concluir
                            <% } %>
                        </button>
                    </div>
                    <div class="lesson-description">
                        <%= currentLesson.descricao %>
                    </div>
                </div>
            <% } else { %>
                <div class="no-lesson-selected">
                    <h2>Selecione uma aula para começar</h2>
                </div>
            <% } %>
        </section>
    </main>

    <!-- Modal de Avaliação -->
    <% if (progress >= 100 && !hasRated) { %>
    <div id="rating-modal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Parabéns por concluir o curso!</h3>
                <p>Sua opinião é muito importante para nós. Como você avaliaria este curso?</p>
            </div>
            <form id="rating-form">
                <div class="star-rating">
                    <input type="radio" id="star5" name="nota" value="5" /><label for="star5" title="5 estrelas"></label>
                    <input type="radio" id="star4" name="nota" value="4" /><label for="star4" title="4 estrelas"></label>
                    <input type="radio" id="star3" name="nota" value="3" /><label for="star3" title="3 estrelas"></label>
                    <input type="radio" id="star2" name="nota" value="2" /><label for="star2" title="2 estrelas"></label>
                    <input type="radio" id="star1" name="nota" value="1" /><label for="star1" title="1 estrela"></label>
                </div>
                <div class="form-group">
                    <textarea name="comentario" placeholder="Conte-nos o que você achou do curso..." required></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" onclick="closeRatingModal()">Depois</button>
                    <button type="submit" class="btn btn-primary">Enviar Avaliação</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <script>
        function toggleModule(index) {
            const list = document.getElementById(`module-${index}`);
            list.classList.toggle('collapsed');
        }

        const sidebarToggleBtn = document.getElementById('mobile-sidebar-toggle');
        const courseSidebar = document.getElementById('course-sidebar');
        if (sidebarToggleBtn && courseSidebar) {
            sidebarToggleBtn.addEventListener('click', () => {
                courseSidebar.classList.toggle('mobile-open');
                if (courseSidebar.classList.contains('mobile-open')) {
                    sidebarToggleBtn.innerHTML = '<i class="fas fa-times"></i> Fechar Aulas';
                } else {
                    sidebarToggleBtn.innerHTML = '<i class="fas fa-list"></i> Ver Aulas';
                }
            });
        }

        const completeBtn = document.getElementById('complete-btn');
        const isAlreadyCompleted = completeBtn && completeBtn.classList.contains('completed');

        // Função central para desbloquear o botão de conclusão
        function enableCompleteBtn() {
            if (!completeBtn || isAlreadyCompleted) return;
            completeBtn.disabled = false;
            completeBtn.classList.remove('locked');
            completeBtn.innerHTML = 'Marcar como Concluída';
            // Animação de pulso para chamar atenção
            completeBtn.style.animation = 'none';
            completeBtn.offsetHeight; // reflow trick
            completeBtn.style.animation = 'pulseUnlock 0.6s ease';
        }

        // --- Detecção de tipo de player ---
        const youtubePlayer = document.getElementById('youtube-player');
        const vimeoPlayer   = document.getElementById('vimeo-player');
        const html5Player   = document.getElementById('html5-player');

        if (isAlreadyCompleted) {
            // Nada a fazer, já concluída
        } else if (html5Player) {
            // Vídeo HTML5 nativo
            html5Player.addEventListener('ended', enableCompleteBtn);
            // Se o usuário pular para o fim (currentTime >= 95% do total)
            html5Player.addEventListener('timeupdate', () => {
                if (html5Player.duration && html5Player.currentTime >= html5Player.duration * 0.95) {
                    enableCompleteBtn();
                }
            });
        } else if (youtubePlayer) {
            // YouTube IFrame Player API
            function initYTPlayer() {
                const player = new YT.Player('youtube-player', {
                    events: {
                        'onReady': function(event) {
                            console.log('YouTube Player API conectada com sucesso.');
                            setInterval(() => {
                                if (typeof player.getCurrentTime === 'function') {
                                    const currentTime = player.getCurrentTime();
                                    const duration = player.getDuration();
                                    if (duration > 0 && currentTime >= duration * 0.95) {
                                        enableCompleteBtn();
                                    }
                                }
                            }, 1000);
                        },
                        'onStateChange': function(event) {
                            // YT.PlayerState.ENDED === 0
                            if (event.data === 0) enableCompleteBtn();
                        }
                    }
                });
            }

            if (window.YT && window.YT.Player) {
                initYTPlayer();
            } else {
                window.onYouTubeIframeAPIReady = initYTPlayer;
                const ytScript = document.createElement('script');
                ytScript.src = 'https://www.youtube.com/iframe_api';
                document.head.appendChild(ytScript);
            }
        } else if (vimeoPlayer) {
            // Vimeo Player SDK
            const vimeoScript = document.createElement('script');
            vimeoScript.src = 'https://player.vimeo.com/api/player.js';
            vimeoScript.onload = function() {
                const player = new Vimeo.Player(vimeoPlayer);
                player.on('ended', enableCompleteBtn);
                // Também dispara quando >95% do vídeo foi assistido
                player.on('timeupdate', function(data) {
                    if (data.percent >= 0.95) enableCompleteBtn();
                });
            };
            document.head.appendChild(vimeoScript);
        } else {
            // PDF, slide ou sem vídeo: habilitar imediatamente
            enableCompleteBtn();
        }

        if (completeBtn) {
            completeBtn.addEventListener('click', async () => {
                if (completeBtn.classList.contains('completed') || completeBtn.disabled) return;

                try {
                    const response = await fetch('/api/progress/complete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ lessonId: '<%= currentLesson ? currentLesson.id : "" %>' })
                    });

                    if (response.ok) {
                        completeBtn.classList.add('completed');
                        completeBtn.innerHTML = '<i class="fa-solid fa-check"></i> Concluída';
                        // Recarregar para atualizar barra de progresso e sidebar
                        setTimeout(() => window.location.reload(), 500);
                    } else {
                        alert('Erro ao marcar como concluída.');
                    }
                } catch (error) {
                    console.error('Erro:', error);
                    alert('Erro ao processar requisição.');
                }
            });
        }

        // Lógica do Modal de Avaliação
        const ratingForm = document.getElementById('rating-form');
        if (ratingForm) {
            ratingForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(ratingForm);
                const nota = formData.get('nota');
                const comentario = formData.get('comentario');

                if (!nota) {
                    alert('Por favor, selecione uma nota de 1 a 5 estrelas.');
                    return;
                }

                try {
                    const response = await fetch('/api/cursos/<%= course.id %>/reviews', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ nota, comentario })
                    });

                    if (response.ok) {
                        showToast('Avaliação enviada com sucesso!', 'success');
                        closeRatingModal();
                        // Opcional: Redirecionar para dashboard ou mostrar botão de certificado
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        alert('Erro ao enviar avaliação.');
                    }
                } catch (error) {
                    console.error('Erro:', error);
                    alert('Erro de conexão.');
                }
            });
        }

        function closeRatingModal() {
            const modal = document.getElementById('rating-modal');
            if (modal) modal.style.display = 'none';
        }
    </script>
</body>
</html>
