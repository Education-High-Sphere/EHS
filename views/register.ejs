<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <link rel="icon" href="../src/logo.png" type="image/x-icon" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <link rel="stylesheet" href="../styles/register.css" />
    <title>EHS Cadastro</title>
  </head>
  <body>
    <div class="logo-img">
      <img src="../src/group.png" alt="logo" />
    </div>
    <div class="vertical-line"></div>

    <main class="container-register">
      <label class="label"><h1>Cadastro</h1></label>

      <form
        class="form-container"
        action="/api/users/register"
        method="POST"
      >
        <div class="input-box">
          <input name="name" placeholder="Nome" type="text" required />
        </div>

        <div class="input-box">
          <input
            name="email"
            placeholder="Endereço de e-mail"
            type="email"
            required
            pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
            oninvalid="setCustomValidity('Por favor, insira um endereço de e-mail válido.')"
            oninput="setCustomValidity('')"
          />
        </div>

        <!-- Campos opcionais removidos para simplificar o cadastro (birth_date, email_confirm, job, phone) -->


        <div class="input-box">
          <input
            id="senha"
            name="password"
            placeholder="Senha"
            type="password"
            required
          />
          <a href="#" onclick="togglePassword()"
            ><i class="bx bx-hide" id="togglePassword"></i
          ></a>
        </div>

        <div class="input-box">
          <input
            name="confirmar_senha"
            id="confirmar_senha"
            placeholder="Confirme sua senha"
            type="password"
            required
          />
          <a href="#" onclick="toggleConfirmPassword()"
            ><i class="bx bx-hide" id="toggleConfirmPassword"></i
          ></a>
        </div>

        <p class="switch-form">
          Já possui uma conta? <a href="#" onclick="showLogin()">Login</a>
        </p>


        <div class="termos-aceite">
          <label class="custom-checkbox">
            <input name="termos_aceitos" type="checkbox" value="sim" required />
            <span class="checkmark"></span>
            Li e aceito os
            <a href="https://docs.google.com/document/d/18FU5_gQSPcEtJKLUI8QV5AylzMUeDWx4/edit?usp=drive_link&ouid=103953523816036755309&rtpof=true&sd=true" target="_blank"
              >Termos de uso do EHS, Aviso de privacidade, Termos LGPD.</a
            >
          </label>
        </div>

        <div class="g-recaptcha" data-sitekey="<%= RECAPTCHA_SITE_KEY %>"></div>

        <button type="submit">Cadastre-se</button>
      </form>
    </main>

    <main class="container-login" style="display: none">
      <label class="label"><h1>Login</h1></label>

      <form
        class="form-container"
        action="api/users/login"
        method="POST"
      >
        <div class="input-box">
          <input name="email" placeholder="E-mail" type="email" required />
        </div>

        <div class="input-box">
          <input
            id="senha_login"
            name="password"
            placeholder="Senha"
            type="password"
            required
          />
          <a href="#" onclick="toggleLoginPassword()"
            ><i class="bx bx-hide" id="toggleLoginPasswordIcon"></i
          ></a>
        </div>

        <div class="remember-forgot">
          <label class="custom-checkbox">
            <input name="lembrar" type="checkbox" value="sim" />
            <span class="checkmark"></span>
            Lembrar de mim
          </label>
          <a href="#" style="color: #4a78a6; text-decoration: none"
            >Esqueceu a senha?</a
          >
        </div>

        <p class="switch-form">
          Não possui uma conta?
          <a href="#" onclick="showRegister()">Cadastre-se</a>
        </p>

        <div class="termos-aceite">
            <label class="custom-checkbox">
              <input name="termos_aceitos_login" type="checkbox" value="sim" required />
              <span class="checkmark"></span>
              Li e aceito os
              <a href="https://docs.google.com/document/d/18FU5_gQSPcEtJKLUI8QV5AylzMUeDWx4/edit?usp=drive_link&ouid=103953523816036755309&rtpof=true&sd=true" target="_blank"
                >Termos de uso do EHS, Aviso de privacidade, Termos LGPD.</a
              >
            </label>
        </div>

        <div class="g-recaptcha" data-sitekey="<%= RECAPTCHA_SITE_KEY %>"></div>

        <button type="submit">Entrar</button>
      </form>
    </main>

    <style>
      .spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        vertical-align: middle;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }
    </style>

    <script>
      function showLogin() {
        document.querySelector(".container-register").style.display = "none";
        document.querySelector(".container-login").style.display = "block";
      }

      function showRegister() {
        document.querySelector(".container-login").style.display = "none";
        document.querySelector(".container-register").style.display = "block";
      }

      function verifyPassword() {
        var senha = document.getElementById("senha").value;
        var confirmar_senha = document.getElementById("confirmar_senha").value;

        if (senha !== confirmar_senha) {
          alert("As senhas não coincidem, por favor, tente novamente.");
          return false;
        }

        return true;
      }

      // A verificação de e-mail foi removida (o campo email_confirm foi retirado)

      function togglePassword() {
        var passwordInput = document.getElementById("senha");
        var icon = document.getElementById("togglePassword");
        if (passwordInput.type === "password") {
          passwordInput.type = "text";
          icon.style.color = "#4A78A6";
          icon.className = "bx bx-show";
        } else {
          passwordInput.type = "password";
          icon.style.color = "gray";
          icon.className = "bx bx-hide";
        }
      }

      function toggleLoginPassword() {
        var passwordInput = document.getElementById("senha_login");
        var icon = document.getElementById("toggleLoginPasswordIcon");
        if (passwordInput.type === "password") {
          passwordInput.type = "text";
          icon.style.color = "#4A78A6";
          icon.className = "bx bx-show";
        } else {
          passwordInput.type = "password";
          icon.style.color = "gray";
          icon.className = "bx bx-hide";
        }
      }

      function toggleConfirmPassword() {
        var passwordInput = document.getElementById("confirmar_senha");
        var icon = document.getElementById("toggleConfirmPassword");
        if (passwordInput.type === "password") {
          passwordInput.type = "text";
          icon.style.color = "#4A78A6";
          icon.className = "bx bx-show";
        } else {
          passwordInput.type = "password";
          icon.style.color = "gray";
          icon.className = "bx bx-hide";
        }
      }

      // Lidar com erros retornados pela URL (ex: falha no login)
      window.onload = function() {
        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');
        const tab = urlParams.get('tab');
        
        if (error) {
          // Pequeno timeout para garantir que a página renderizou antes do alert
          setTimeout(() => {
            alert(error);
          }, 100);
        }
        
        if (tab === 'login') {
          showLogin();
        }
      };

      // Spinner de loading nos formulários
      document.querySelectorAll('.form-container').forEach(form => {
        form.addEventListener('submit', function() {
          const btn = this.querySelector('button[type="submit"]');
          if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span> Aguarde...';
          }
        });
      });
    </script>
  </body>
</html>
