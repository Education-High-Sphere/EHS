<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nossos Cursos</title>

    <link rel="stylesheet" href="../styles/courses.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>

  <body>
    <%- include('common/header'); %>
    <nav class="filters">
        <span class="filter-group">
            <span>Filtrar por</span>
            <select id="categoryFilter" class="category-filter">
                <option value="">Todas as categorias</option>
                <option value="tecnologia">Tecnologia e Inovação</option>
                <option value="negocios">Negócios e Empreendedorismo</option>
                <option value="design">Design e Criatividade</option>
                <option value="marketing">Marketing Digital</option>
                <option value="desenvolvimento-pessoal">Desenvolvimento Pessoal</option>
                <option value="linguas">Línguas Estrangeiras</option>
                <option value="ciencia-dados">Ciência de Dados</option>
                <option value="financas">Finanças e Investimentos</option>
                <option value="saude-bem-estar">Saúde e Bem-estar</option>
                <option value="educacao">Educação e Ensino</option>
           </select>

            <select id="levelFilter" class="level-filter">
                <option value="">Todos os niveis</option>
                <option value="iniciante">Iniciante</option>
                <option value="intermediario">Intermediário</option>
                <option value="avancado">Avançado</option>
            </select>

            <select id="durationFilter" class="duration-filter">
                <option value="">Qualquer duração</option>
                <option value="curto">Curto (menos de 2 horas)</option>
                <option value="medio">Médio (2 a 10 horas)</option>
                <option value="longo">Longo (mais de 10 horas)</option>
            </select>

            <select id="priceFilter" class="price-filter">
                <option value="">Qualquer preco</option>
                <option value="gratuito">Gratuito</option>
                <option value="pago">Pago</option>
            </select>

            <select class="order-filter" id="orderFilter">
                <option value="recentes">Mais recentes</option>
                <option value="antigos">Mais antigos</option>
                <option value="alfabetica">Ordem alfabética</option>
            </select>

            
        </span>

        <button id="applyFilters">Aplicar Filtros</button>
    </nav>

    <h2 class="section-title">Nossos Cursos</h2>

    <div class="course-grid">
      <% if (courses && courses.length > 0) { %> <% courses.forEach(course => { %>
      <div class="course-card">
        <div class="course-info">
          <div class="info-top">
            <span class="course-category" style="background-color: <% switch (course.categoria) {
                case 'tecnologia':
                    return '#0f1e38';
                case 'negocios':
                    return '#28a745';
                case 'design':
                    return '#ffc107';
                case 'marketing':
                    return '#17a2b8';
                case 'desenvolvimento-pessoal':
                    return '#dc3545';
                case 'linguas':
                    return '#6f42c1';
                case 'ciencia-dados':
                    return '#343a40';
                case 'financas':
                    return '#007bff';                
                    
                default:
                    return '#0f1e38';
            } %>"><%= course.categoria %></span>

            <h3 class="course-title"><%= course.nome %></h3>
          </div>

          <div class="info-img">
            <img
              src="<%= courses.imagem ? courses.imagem : '' %>"
              alt="<%= courses.nome ? courses.nome : '' %>"
            />
          </div>

          <div class="info-bottom">
            <% if (courses.descricao && courses.descricao.length > 0) { %>
            <div class="courses-description">
              <p><%= courses.descricao %></p>
            </div>
            <% } %>
          </div>
        </div>
        <button class="continue-button">Assistir curso</button>
      </div>
      <% }); %> <% } else { %>
      <p>Nenhum curso na plataforma</p>
      <% } %>
    </div>


    <%-include ('common/footer')-%>

    <script>
      async function getAllCourses() {
        try {
          const res = await fetch('/cursos');
          const data = await res.json();
          const courses = document.querySelector('.course-grid');
          courses.innerHTML = '';
          data.forEach(course => {
            const card = document.createElement('div');
            card.className = 'course-card';
            card.innerHTML = `
              <div class="course-info">
                <div class="info-top">
                  <span class="course-category">${course.categoria}</span>
                  <h3 class="course-title">${course.nome}</h3>
                </div>

                <div class="info-img">
                  <img src="${course.imagem}" alt="${course.nome}">
                </div>

                <div class="info-bottom">
                  ${course.descricao ? `<div class="courses-description"><p>${course.descricao}</p></div>` : ''}
                </div>
              </div>
              <button class="continue-button">Assistir curso</button>
            `;
            courses.appendChild(card);
          });
        } catch (error) {
          console.error(error);
        }
      }

      getAllCourses();
    </script>
  </body>
</html>

