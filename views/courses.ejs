<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nossos Cursos</title>

    <link rel="stylesheet" href="../styles/courses.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>

  <body>
    <%- include('common/header'); %>

    <nav class="filters">
      <span class="filter-group">
        <span>Filtrar por</span>
        <select id="categoryFilter" class="category-filter">
          <option value="">Todas as categorias</option>
          <option value="tecnologia">Tecnologia e Inovação</option>
          <option value="negocios">Negócios e Empreendedorismo</option>
          <option value="design">Design e Criatividade</option>
          <option value="marketing">Marketing Digital</option>
          <option value="desenvolvimento-pessoal">
            Desenvolvimento Pessoal
          </option>
          <option value="linguas">Línguas Estrangeiras</option>
          <option value="ciencia-dados">Ciência de Dados</option>
          <option value="financas">Finanças e Investimentos</option>
          <option value="saude-bem-estar">Saúde e Bem-estar</option>
          <option value="educacao">Educação e Ensino</option>
        </select>

        <select id="levelFilter" class="level-filter">
          <option value="">Todos os níveis</option>
          <option value="Básico">Básico</option>
          <option value="Intermediário">Intermediário</option>
          <option value="Avançado">Avançado</option>
        </select>

        <select id="durationFilter" class="duration-filter">
          <option value="">Qualquer duração</option>
          <option value="curto">Curto (menos de 2 horas)</option>
          <option value="medio">Médio (2 a 10 horas)</option>
          <option value="longo">Longo (mais de 10 horas)</option>
        </select>

        <select id="priceFilter" class="price-filter">
          <option value="">Qualquer preco</option>
          <option value="gratuito">Gratuito</option>
          <option value="pago">Pago</option>
        </select>

        <select class="order-filter" id="orderFilter">
          <option value="recentes">Mais recentes</option>
          <option value="antigos">Mais antigos</option>
        </select>
      </span>

      <button id="applyFilters">Aplicar Filtros</button>
    </nav>

    <h2 class="section-title">Nossos Cursos</h2>

    <div class="course-grid">
      <% if (courses && courses.length > 0) { %> <% courses.forEach(course => {
      %>
      <div
        class="course-card"
        data-level="<%= course.nivel %>"
        data-duration="<%= course.duracao %>"
        data-price="<%= parseFloat(course.preco) === 0 ? 'gratuito' : 'pago' %>"
        data-created-at="<%= course.data_criacao %>"
      >
        <div class="course-info">
          <div class="info-top">
            <% const categories = {
              'tecnologia': '#4a78a6',
              'marketing': '#e67e73',
              'empreendedorismo': '#8b9467',
              'softskills': '#4299e1',
              'design': '#ff9900',
              'linguas': '#6495ed',
              'ciencia de dados': '#9bc9e6',
              'financas e investimentos': '#ffcc00',
              'saude e bem-estar': '#8bc34a',
              'educacao e ensino': '#607d8b',
              'programacao': '#f28a8c',              // Um tom de vermelho/rosa suave
              'fotografia e video': '#9d81ba',    // Roxo/lavanda elegante
              'musica e artes': '#a68a64',            // Marrom terroso, bom para artes
              'culinaria': '#f4a261',                 // Laranja vibrante, como comida
              'direito e legislacao': '#52796f',     // Verde escuro, sóbrio e profissional
              'gestao de projetos': '#7e9a9a',
              'negócios & finanças': '#f5a623',               
            };
            const backgroundColor = categories[course.categoria.toLowerCase()] || '#01a3a3'; %>
            <span
              class="course-category"
              style="background-color: <%= backgroundColor %>"
              ><%= course.categoria %></span
            >
            <h3 class="course-title"><%= course.nome %></h3>
          </div>

          <div class="info-img">
            <img
              src="<%= course.imagem ? course.imagem : '' %>"
              alt="<%= course.nome ? course.nome : '' %>"
            />
          </div>

          <div class="info-bottom">
            <% if (course.descricao && course.descricao.length > 0) { %>
            <div class="courses-description">
              <p><%= course.descricao %></p>
            </div>
            <% } %>
          </div>
        </div>
        <button class="continue-button" onclick="location.href='/course/<%= course.id %>'">Assistir curso</button>
      </div>
      <% }); %> <% } else { %>
      <p>Nenhum curso encontrado</p>
      <% } %>
    </div>

    <%-include ('common/footer')-%>

    <script>
            document.addEventListener("DOMContentLoaded", () => {
              // Seleciona todos os filtros e os cartões de curso
              const filters = document.querySelectorAll(".filters select");
              const coursesGrid = document.querySelector(".course-grid");
              const allCourses = Array.from(
                document.querySelectorAll(".course-card")
              );

              // Função para aplicar os filtros
              const applyFilters = () => {
                const categoryFilter =
                  document.getElementById("categoryFilter").value;
                const levelFilter = document.getElementById("levelFilter").value;
                const durationFilter =
                  document.getElementById("durationFilter").value;
                const priceFilter = document.getElementById("priceFilter").value;
                const orderFilter = document.getElementById("orderFilter").value;

                // Crie um array para os cursos que serão exibidos
                let filteredCourses = [...allCourses];

                // Lógica para filtrar por Categoria
                if (categoryFilter) {
                  filteredCourses = filteredCourses.filter((courseCard) => {
                    const category = courseCard
                      .querySelector(".course-category")
                      .textContent.trim()
                      .toLowerCase();
                    return category.includes(categoryFilter);
                  });
                }

                // Lógica para filtrar por Nível (adicionar no seu HTML se não tiver)
                if (levelFilter) {
                  filteredCourses = filteredCourses.filter((courseCard) => {
                    const level = courseCard.dataset.level; // Converte o valor do `data-level` para minúsculas
                    return level === levelFilter;
                  });
                }

                if (durationFilter) {
                  filteredCourses = filteredCourses.filter((courseCard) => {
                    const duration = courseCard.dataset.duration.toLowerCase();
                    return duration === durationFilter;
                  });
                }

                if (priceFilter) {
                  filteredCourses = filteredCourses.filter((courseCard) => {
                    const price = courseCard.dataset.price.toLowerCase();
                    return price === priceFilter;
                
                  });
                }

                // Lógica para ordenação
                if (orderFilter === 'recentes') {
                filteredCourses.sort((a, b) => {
                  // Acessa o atributo de data diretamente do elemento principal
                  const dateA = new Date(a.dataset.createdAt);
                  const dateB = new Date(b.dataset.createdAt);
                  return dateB - dateA; // Ordena do mais novo para o mais antigo
                });
                } else if (orderFilter === 'antigos') {
                  filteredCourses.sort((a, b) => {
                    // Acessa o atributo de data diretamente do elemento principal
                    const dateA = new Date(a.dataset.createdAt);
                    const dateB = new Date(b.dataset.createdAt);
                    return dateA - dateB;
                  });
                }

                // Limpa a grade de cursos
                coursesGrid.innerHTML = "";

                // Adiciona os cursos filtrados/ordenados de volta à tela
                if (filteredCourses.length > 0) {
                  filteredCourses.forEach((course) => {
                    coursesGrid.appendChild(course);
                  });
                } else {
                  coursesGrid.innerHTML =
                    "<p>Nenhum curso encontrado com os filtros selecionados.</p>";
                }
              };

              // Adiciona o evento de clique ao botão
              const applyFiltersButton = document.getElementById("applyFilters");
              applyFiltersButton.addEventListener("click", applyFilters);
            });
    </script>
  </body>
</html>

