<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nossos Cursos</title>

    <link rel="stylesheet" href="../styles/courses.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>

  <body>
    <%- include('common/header'); %>

    <nav class="filters">
      <span class="filter-group">
        <span>Filtrar por</span>
        <select id="categoryFilter" class="category-filter">
          <% if (categories && categories.length > 0) { %>
            <option value="">Qualquer categoria</option>
            <% for (const category of categories) { %>
              <option value="<%= category %>"><%= category %></option>
            <% } %>
          <% } %>
        </select>

        <select id="levelFilter" class="level-filter">
          <option value="">Todos os níveis</option>
          <option value="Iniciante">Iniciante</option>
          <option value="Intermediário">Intermediário</option>
          <option value="Avançado">Avançado</option>
        </select>

        <select id="durationFilter" class="duration-filter">
          <option value="">Qualquer duração</option>
          <option value="curto">Curto (menos de 2 horas)</option>
          <option value="medio">Médio (2 a 10 horas)</option>
          <option value="longo">Longo (mais de 10 horas)</option>
        </select>

        <select id="priceFilter" class="price-filter">
          <option value="">Qualquer preço</option>
          <option value="gratuito">Gratuito</option>
          <option value="pago">Pago</option>
        </select>

        <select class="order-filter" id="orderFilter">
          <option value="recentes">Mais recentes</option>
          <option value="antigos">Mais antigos</option>
        </select>
      </span>
    </nav>

    <h2 class="section-title">Nossos Cursos</h2>
    

    <div class="courses-grid">

    <% courses.forEach(course => { if (course.publicated) { %>

  <div
    class="course-card"
    data-category="<%= course.categoria %>"
    data-level="<%= course.nivel %>"
    data-duration="<%- getDurationKey(course.duracao) %>"
    data-price="<%= parseFloat(course.preco) === 0 ? 'gratuito' : 'pago' %>"
    data-created-at="<%= course.data_criacao %>"
  >
    <div class="course-image-container">
      <% 
        const _placeholders = [
          'https://images.unsplash.com/photo-1516321497487-e288fb19713f?w=600&q=80',
          'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=600&q=80',
          'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&q=80',
          'https://images.unsplash.com/photo-1501504905252-473c47e087f8?w=600&q=80',
          'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&q=80',
          'https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=600&q=80'
        ];
        const _phIndex = course.nome ? course.nome.length % _placeholders.length : 0;
        const _finalImg = _placeholders[_phIndex];
      %>
      <img
        src="<%= course.imagem || _finalImg %>"
        alt="<%= course.nome %>"
        onerror="this.onerror=null;this.src='<%= _finalImg %>';"
      />
      
      <% 
        const categories = {
          'tecnologia': '#4a78a6', 'marketing': '#e67e73', 'empreendedorismo': '#8b9467',
          'softskills': '#4299e1', 'design': '#ff9900', 'linguas': '#6495ed',
          'ciencia de dados': '#9bc9e6', 'financas e investimentos': '#ffcc00',
          'saude e bem-estar': '#8bc34a', 'educacao e ensino': '#607d8b',
          'programacao': '#f28a8c', 'fotografia e video': '#9d81ba',
          'musica e artes': '#a68a64', 'culinaria': '#f4a261',
          'direito e legislacao': '#52796f', 'gestao de projetos': '#7e9a9a',
          'negócios & finanças': '#f5a623', 
        };
        const backgroundColor = categories[course.categoria.toLowerCase()] || '#01a3a3'; 
      %>
      <span class="course-category-tag" style="background-color: <%= backgroundColor %>">
        <%= course.categoria %>
      </span>

      <a href="/course/<%= course.id %>" class="course-hover-button">Ver Detalhes</a>
    </div>

    <div class="course-content-container">
      <h3 class="course-title"><%= course.nome %></h3>
      
      <p class="course-professor">Por <%= course.professor_nome || 'Professor EHS' %></p>
      
      <div class="course-rating">
        <i class="fas fa-star"></i>
        <span class="rating-score"><%= (course.avaliacao_media && course.avaliacao_media > 0) ? course.avaliacao_media.toFixed(1) : 'Novo' %></span>
        <span class="rating-count">(<%= course.alunos || 0 %>)</span>
      </div>
      
      <div class="course-metadata">
        <span><i class="fas fa-layer-group"></i> <%= course.nivel %></span>
        <span><i class="fas fa-clock"></i> <%= course.duracao %></span>
      </div>
      
      <div class="spacer"></div> 
      
      <div class="course-price">
        <% if (parseFloat(course.preco) === 0) { %>
          <h3 class="free">Gratuito</h3>
        <% } else { %>
          <h3 class="current-price">R$ <%= parseFloat(course.preco).toFixed(2) %></h3>
        <% } %>
      </div>
    </div>
  </div>

<% } }); %>

<% 
  function getDurationKey(duracaoStr) {
    const duracaoHoras = parseInt(duracaoStr) || 0;
    if (duracaoHoras < 2) return 'curto';
    if (duracaoHoras <= 10) return 'medio';
    return 'longo';
  } 
%>
</div>

<!-- Estado vazio -->
<div id="empty-state" style="display:none; grid-column:1/-1; text-align:center; padding:60px 20px; color:#a0aec0;">
  <i class="fas fa-search" style="font-size:3rem; margin-bottom:16px; display:block; opacity:0.4;"></i>
  <h3 style="margin-bottom:8px; color:#f4f4f4;">Nenhum curso encontrado</h3>
  <p>Tente remover alguns filtros para ver mais resultados.</p>
  <button onclick="resetFilters()" style="margin-top:16px; padding:10px 24px; border-radius:8px; border:1px solid #4a78a6; background:transparent; color:#4a78a6; cursor:pointer; font-weight:600; transition:all 0.2s;" onmouseover="this.style.background='#4a78a6';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#4a78a6'">
    Limpar filtros
  </button>
</div>

    <% if (totalPages > 1) { %>
      <nav class="pagination">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>"><i class="fas fa-chevron-left"></i></a>
        <% } else { %>
          <span class="disabled"><i class="fas fa-chevron-left"></i></span>
        <% } %>
        
        <% for(let i = 1; i <= totalPages; i++) { %>
          <% if (i === currentPage) { %>
            <span class="active"><%= i %></span>
          <% } else { %>
            <a href="?page=<%= i %><%= searchQuery ? '&search=' + searchQuery : '' %>"><%= i %></a>
          <% } %>
        <% } %>
        
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>"><i class="fas fa-chevron-right"></i></a>
        <% } else { %>
          <span class="disabled"><i class="fas fa-chevron-right"></i></span>
        <% } %>
      </nav>
    <% } %>

    <%-include ('common/footer')-%>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const coursesGrid = document.querySelector(".courses-grid");
        const emptyState  = document.getElementById("empty-state");
        const allCourses  = Array.from(document.querySelectorAll(".course-card"));

        // ---- Função principal de filtragem ----
        const applyFilters = () => {
          const categoryFilter = document.getElementById("categoryFilter").value.trim().toLowerCase();
          const levelFilter    = document.getElementById("levelFilter").value.trim();
          const durationFilter = document.getElementById("durationFilter").value.trim().toLowerCase();
          const priceFilter    = document.getElementById("priceFilter").value.trim().toLowerCase();
          const orderFilter    = document.getElementById("orderFilter").value;

          let filtered = allCourses.filter(card => {
            const cat      = (card.dataset.category || '').toLowerCase();
            const level    = (card.dataset.level    || '').trim();
            const duration = (card.dataset.duration || '').toLowerCase();
            const price    = (card.dataset.price    || '').toLowerCase();

            if (categoryFilter && cat !== categoryFilter) return false;
            if (levelFilter    && level !== levelFilter)  return false;
            if (durationFilter && duration !== durationFilter) return false;
            if (priceFilter    && price !== priceFilter)  return false;
            return true;
          });

          // Ordenação
          filtered.sort((a, b) => {
            const dateA = new Date(a.dataset.createdAt || 0);
            const dateB = new Date(b.dataset.createdAt || 0);
            return orderFilter === 'antigos' ? dateA - dateB : dateB - dateA;
          });

          // Re-renderização (move nodes, sem innerHTML para não perder eventos)
          allCourses.forEach(card => coursesGrid.removeChild(card));
          filtered.forEach(card => coursesGrid.appendChild(card));

          // Estado vazio
          if (filtered.length === 0) {
            emptyState.style.display = 'block';
          } else {
            emptyState.style.display = 'none';
          }
        };

        // Escuta mudanças em qualquer filtro — sem botão
        document.querySelectorAll(".filters select").forEach(select => {
          select.addEventListener("change", applyFilters);
        });

        // Função de reset acessível globalmente (usada pelo botão no empty state)
        window.resetFilters = () => {
          document.querySelectorAll(".filters select").forEach(sel => sel.selectedIndex = 0);
          applyFilters();
        };

        // Aplica ordenação inicial (mais recentes por padrão)
        applyFilters();
      });
    </script>
  </body>
</html>

