<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"/>
    <link rel="stylesheet" href="../styles/userScene.css" />
    <title>Dashboard do Usuário - EHSYNC</title>
  </head>
  <body>
    <%-include ('common/header')-%>

    <div class="dashboard-header">
      <div class="header-content">
        <h1>Bem-vindo(a) de volta, <%= user.name.split(' ')[0] %>! 👋</h1>
        <p>Acompanhe seu progresso e retome seus cursos de onde parou.</p>
      </div>
      <button class="logout-button" id="logout"><i class="fas fa-sign-out-alt"></i> Sair</button>
    </div>

    <div class="dashboard-container">
      <!-- SIDEBAR PROFILE -->
      <aside class="profile-card">
        <div class="profile-header">
          <div class="user-avatar-wrapper">
            <img src="<%= user.avatar ? user.avatar : '../src/user.png' %>" alt="Foto de perfil" class="user-avatar" />
          </div>
          <h2 class="user-name"><%= user.name %></h2>
          <span class="user-job"><%= user.job || 'Estudante' %></span>
          <button class="edit-btn" onclick="window.location.href='/edit'">Editar Perfil <i class="fas fa-edit"></i></button>
        </div>

        <div class="profile-details">
          <% if (user.email) { %>
          <div class="detail-item">
            <i class="fas fa-envelope"></i>
            <span><%= user.email %></span>
          </div>
          <% } %>
          <% if (user.phone) { %>
          <div class="detail-item">
            <i class="fas fa-phone"></i>
            <span><%= user.phone %></span>
          </div>
          <% } %>
          <div class="detail-item">
            <i class="fas fa-calendar-alt"></i>
            <span>Membro desde <%= new Date(user.created_at).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></span>
          </div>
        </div>

        <div class="profile-stats">
          <div class="stat-box">
            <i class="fas fa-trophy highlight-icon"></i>
            <div class="stat-info">
              <strong>34</strong>
              <span>Cursos Concluídos</span>
            </div>
          </div>
          <div class="stat-box">
            <i class="fas fa-star highlight-icon-sec"></i>
            <div class="stat-info">
              <strong>12</strong>
              <span>Avaliações</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="dashboard-content">
        
        <!-- NEW IMPLEMENTATION: DASHBOARD OVERVIEW -->
        <section class="overview-section">
          <div class="overview-card">
            <div class="icon-wrapper blue">
              <i class="fas fa-book-open"></i>
            </div>
            <div class="overview-data">
              <h3>4</h3>
              <p>Cursos em andamento</p>
            </div>
          </div>
          <div class="overview-card">
            <div class="icon-wrapper green">
              <i class="fas fa-check-circle"></i>
            </div>
            <div class="overview-data">
              <h3>34</h3>
              <p>Cursos finalizados</p>
            </div>
          </div>
          <div class="overview-card">
            <div class="icon-wrapper purple">
              <i class="fas fa-clock"></i>
            </div>
            <div class="overview-data">
              <h3>120h</h3>
              <p>Horas de estudo</p>
            </div>
          </div>
        </section>

        <!-- TABS NAV -->
        <nav class="dashboard-tabs">
          <button class="tab-btn active" data-tab="courses-tab">Meus Cursos</button>
          <button class="tab-btn" data-tab="certificates-tab">Certificados</button>
        </nav>

        <!-- COURSES LIST -->
        <section class="courses-list" id="courses-tab">
          <div class="section-title">
            <h2><i class="fas fa-graduation-cap"></i> Continue aprendendo</h2>
          </div>
          
          <div class="courses-grid">
            <!-- Curso 1 -->
            <div class="course-card">
              <div class="course-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60')"></div>
              <div class="course-info">
                <h3>Desenvolvimento Web Avançado</h3>
                <span class="instructor">Prof. João Silva</span>
                
                <div class="course-rating">
                  <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                  </div>
                  <span class="rating-value">4.5</span>
                </div>

                <div class="progress-wrapper">
                  <div class="progress-labels">
                    <span>Progresso</span>
                    <span>60%</span>
                  </div>
                  <div class="progress-container">
                    <div class="progress-bar" style="width: 60%"></div>
                  </div>
                  <small>12 de 20 aulas concluídas</small>
                </div>

                <button class="continue-btn">Retomar Curso <i class="fas fa-play-circle"></i></button>
              </div>
            </div>

            <!-- Curso 2 -->
            <div class="course-card">
              <div class="course-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1573164713988-8665fc963095?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60')"></div>
              <div class="course-info">
                <h3>Banco de Dados Relacionais</h3>
                <span class="instructor">Profª. Maria de Souza</span>
                
                <div class="course-rating">
                  <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i><i class="far fa-star"></i>
                  </div>
                  <span class="rating-value">3.5</span>
                </div>

                <div class="progress-wrapper">
                  <div class="progress-labels">
                    <span>Progresso</span>
                    <span>90%</span>
                  </div>
                  <div class="progress-container">
                    <div class="progress-bar" style="width: 90%"></div>
                  </div>
                  <small>16 de 18 aulas concluídas</small>
                </div>

                <button class="continue-btn">Retomar Curso <i class="fas fa-play-circle"></i></button>
              </div>
            </div>

            <!-- Curso 3 -->
            <div class="course-card">
              <div class="course-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1555949963-ff9fe0c870eb?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60')"></div>
              <div class="course-info">
                <h3>Cybersecurity Fundamentals</h3>
                <span class="instructor">Prof. Ademário Silva</span>
                
                <div class="course-rating">
                  <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                  </div>
                  <span class="rating-value">5.0</span>
                </div>

                <div class="progress-wrapper">
                  <div class="progress-labels">
                    <span>Progresso</span>
                    <span>40%</span>
                  </div>
                  <div class="progress-container">
                    <div class="progress-bar" style="width: 40%"></div>
                  </div>
                  <small>4 de 10 aulas concluídas</small>
                </div>

                <button class="continue-btn">Retomar Curso <i class="fas fa-play-circle"></i></button>
              </div>
            </div>
            
            <!-- Curso 4 -->
            <div class="course-card">
              <div class="course-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1561070791-2526d30994b5?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60')"></div>
              <div class="course-info">
                <h3>UX/UI Design Principles</h3>
                <span class="instructor">Profª. Manuela Santos</span>
                
                <div class="course-rating">
                  <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i>
                  </div>
                  <span class="rating-value">3.0</span>
                </div>

                <div class="progress-wrapper">
                  <div class="progress-labels">
                    <span>Progresso</span>
                    <span>65%</span>
                  </div>
                  <div class="progress-container">
                    <div class="progress-bar" style="width: 65%"></div>
                  </div>
                  <small>8 de 12 aulas concluídas</small>
                </div>

                <button class="continue-btn">Retomar Curso <i class="fas fa-play-circle"></i></button>
              </div>
            </div>

          </div>
        </section>

        <!-- CERTIFICATES LIST (New implementation) -->
        <section class="certificates-list hidden" id="certificates-tab">
          <div class="empty-state">
            <i class="fas fa-certificate"></i>
            <h3>Você ainda não possui certificados</h3>
            <p>Conclua cursos para garantir seus certificados e alavancar sua carreira.</p>
          </div>
        </section>

      </main>
    </div>

    <%-include ('common/footer')-%>

    <script>
      // Logout logic
      const logoutButton = document.getElementById("logout");
      if(logoutButton) {
        logoutButton.addEventListener("click", function () {
          window.location.href = "/logout";
        });
      }

      // Tabs logic
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabs = [document.getElementById('courses-tab'), document.getElementById('certificates-tab')];

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active from all
          tabBtns.forEach(b => b.classList.remove('active'));
          tabs.forEach(t => t.classList.add('hidden'));

          // Add active to current
          btn.classList.add('active');
          const target = document.getElementById(btn.getAttribute('data-tab'));
          if(target) target.classList.remove('hidden');
        });
      });
    </script>
  </body>
</html>
