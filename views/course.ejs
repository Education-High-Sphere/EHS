<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../styles/course.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <title><%= course.nome %></title>
  </head>
  <body>
    <%- include('common/header'); %>

    <% 
      const _placeholders = [
        'https://images.unsplash.com/photo-1516321497487-e288fb19713f?w=600&q=80',
        'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=600&q=80',
        'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&q=80',
        'https://images.unsplash.com/photo-1501504905252-473c47e087f8?w=600&q=80',
        'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&q=80',
        'https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=600&q=80'
      ];
      const _phIndex = course.nome ? course.nome.length % _placeholders.length : 0;
      const _finalImg = _placeholders[_phIndex];
    %>
    <section class="course-hero" style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('<%= _finalImg %>');">
        <div class="hero-content">
            <h1 class="course-title"><%= course.nome %></h1>
            <p class="course-description"><%= course.descricao %></p>
            
            <div class="course-meta">
                <span class="meta-item">🕒 Duração: <%= course.duracao %></span>
                <span class="meta-item">📈 Nível: <%= course.nivel %></span>
                <span class="meta-item">💸 Preço: R$<%= course.preco %></span>
            </div>

            <a href="#" class="cta-button">Inscreva-se Agora</a>
        </div>
    </section>

    <section class="course-content">
      <div class="container">
        <h2>Conteúdo do Curso</h2>
        <div class="content-list">
          <% if (content && content.length > 0) { %>
            <% content.forEach(function(module, index) { %>
              <div class="module">
                <h3 class="module-title">Módulo <%= index + 1 %>: <%= module.titulo %></h3>
                <p class="module-description"><%= module.descricao %></p>
                <ul class="lesson-list">
                  <% if (module.lessions && module.lessions.length > 0) { %>
                    <% module.lessions.slice(0, 3).forEach(function(lession) { %>
                      <li class="lesson-item"><%= lession.titulo %></li>
                    <% }); %>
                  <% } else { %>
                    <li class="lesson-item">Nenhuma aula disponível no momento.</li>
                  <% } %>
                </ul>
              </div>
            <% }); %>
          <% } else { %>
            <p>Conteúdo do curso não disponível no momento.</p>
          <% } %>

      </div>

    </section>

    <section class="benefits">
      <div class="container">
        <h2 class="section-title">Quem Mais Se Beneficia</h2>
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="benefit-icon">👥</div>
            <h3>Gestores e Líderes</h3>
            <p>
              Otimize a gestão de equipes e projetos com metodologias
              comprovadas
            </p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">📊</div>
            <h3>Analistas e Coordenadores</h3>
            <p>Implemente processos ágeis e melhore a eficiência operacional</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">🚀</div>
            <h3>Profissionais de TI</h3>
            <p>
              Domine as práticas ágeis essenciais para desenvolvimento de
              software
            </p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">💡</div>
            <h3>Iniciantes em Agilidade</h3>
            <p>Comece sua jornada ágil com fundamentos sólidos e práticos</p>
          </div>
        </div>
      </div>
    </section>

  <h2>Planos Corporativos</h2>
  <div class="cards">
    <!-- Card 1 -->
    <div class="card">
      <h3>Treinamento em Grupo</h3>
      <p class="target">Para equipes de 5 a 20 pessoas</p>
      <ul>
        <li>Turmas exclusivas para sua empresa</li>
        <li>Horários flexíveis adaptados à rotina</li>
        <li>Projetos customizados com cases da empresa</li>
        <li>Suporte dedicado durante 6 meses</li>
      </ul>
      <button class="btn btn-light">Solicitar Proposta</button>
    </div>

    <!-- Card 2 -->
    <div class="card">
      <h3>Licenciamento Corporativo</h3>
      <p class="target">Para empresas com mais de 20 colaboradores</p>
      <ul>
        <li>Acesso ilimitado para todos os funcionários</li>
        <li>Dashboard de acompanhamento de progresso</li>
        <li>Relatórios de performance e engajamento</li>
        <li>Consultoria para implementação das metodologias</li>
      </ul>
      <button class="btn btn-primary">Falar com Especialista</button>
    </div>

    <!-- Card 3 -->
    <div class="card special">
      <h3>Pronto para Transformar sua Empresa?</h3>
      <p>Agende uma consultoria gratuita ou baixe nosso material corporativo para conhecer todos os detalhes.</p>
      <div class="special-buttons">
        <button class="btn btn-primary">Agendar Consultoria Gratuita</button>
        <button class="btn btn-light">Baixar Material Corporativo</button>
      </div>
    </div>
  </div>


    <div class="tutor-container">
      <h1 class="tutor-title">Seu instrutor</h1>
      <div class="tutor-card">
        <div class="tutor-info">
          <div class="info-top">
            <img
              src="../src/professor/professor.png"
              alt="imagem professor"
              class="tutor-image"
            />
            <h3 class="tutor-name"><%= professor.nome %></h3>
            <span class="tutor-role"><%= professor.cargo%></span>
          </div>
          <div class="info-bottom">
            <div class="stars">
    <% 
      const rating = professor.avaliacao_media;
      const fullStars = Math.floor(rating); // estrelas cheias
      const halfStar = rating % 1 >= 0.5;   // estrela pela metade
      const emptyStars = 5 - fullStars - (halfStar ? 1 : 0); // estrelas vazias
    %>

    <% for(let i = 0; i < fullStars; i++) { %>
      <i class="fa-solid fa-star"></i>
    <% } %>

    <% if (halfStar) { %>
      <i class="fa-solid fa-star-half-stroke"></i>
    <% } %>

    <% for(let i = 0; i < emptyStars; i++) { %>
      <i class="fa-regular fa-star"></i>
    <% } %>

    <span><%= rating %> (<%= professor.total_avaliacoes%> avaliações)</span>
  </div>
            <div class="info-xtra">
              <div class="tutor-students">
                <i class="fa-solid fa-user-graduate"></i>
                <span><%= professor.total_alunos%></span>
                <span>Alunos</span>
              </div>
              <div class="tutor-courses">
                <i class="fa-solid fa-book"></i>
                <span><%= professor.total_cursos%></span>
                <span>Cursos</span>
              </div>
            </div>
          </div>
        </div>
        <div class="tutor-profile">
          <div class="tutor-description">
            <h3>Sobre o instrutor</h3>
            <span
              ><%= professor.sobre%></span
            >
          </div>
         <div class="tutor-experience">
            <h3>Experiência Profissional</h3>
            <ul>
              <% professor.experiencias.forEach(experiencia => { %>
                <li><%= experiencia.descricao %></li>
              <% }) %>
            </ul>
          </div>
          <div class="tutor-certificates">
              <h3>Certificações</h3>
              <ul>
                <% if (professor.certificacoes && professor.certificacoes.length > 0) { %>
                  <% professor.certificacoes.forEach(certificado => { %>
                    <li><%= certificado.nome_certificacao %></li>
                  <% }) %>
                <% } else { %>
                  <li>Nenhuma certificação cadastrada.</li>
                <% } %>
              </ul>
          </div>
          </div>
        </div>
      </div>
    </div>

    <div class="ehs-wrapper">
      <div class="ehs-heading">
        <h2>Por que a Education High Sphere?</h2>
        <p>
          Mais de 50.000 profissionais já transformaram suas carreiras conosco
        </p>
      </div>

      <div class="ehs-grid">
        
        <div class="testimonials">
            
            <% if (typeof depoimentos !== 'undefined' && depoimentos.length > 0) { %>

                <% depoimentos.forEach(depoimento => { %>
                    <div class="testimonial-card">
                        <div class="testimonial-top">
                            <div>
                                <div class="stars" aria-hidden="true">
                                    <% for(let i = 0; i < depoimento.avaliacao; i++) { %>
                                        <i class="fa fa-star" aria-hidden="true"></i>
                                    <% } %>
                                </div>
                                <div style="font-size: 13px; color: #334155">
                                    “<%- depoimento.texto_depoimento %>”
                                </div>
                            </div>
                        </div>
                        <div class="testimonial-author"><%- depoimento.nome_autor %></div>
                        <div class="testimonial-role"><%- depoimento.cargo_autor %></div>
                    </div>
                <% }) %>

            <% } else { %>
                <p>Veja o que nossos alunos dizem sobre nós!</p>
            <% } %>

        </div>

        <aside class="diferenciais">
            <div class="features-card">
                <ul>
                    <% if (typeof diferenciais !== 'undefined' && diferenciais.length > 0) { %>
                        <% diferenciais.forEach(item => { %>
                            <li><%- item.texto_diferencial %></li>
                        <% }) %> 
                    
                    <% } %>
                </ul>
            </div>

            <div class="satisfaction">
                <strong>Garantia de Satisfação</strong>
                <p style="margin: 8px 0 0; color: #475569">
                    Não ficou satisfeito? Devolvemos 100% do seu investimento em até
                    30 dias, sem perguntas ou burocracias.
                </p>
            </div>
        </aside>
    </div>
    </div>
    <%- include('common/footer'); %>
  </body>
</html>
