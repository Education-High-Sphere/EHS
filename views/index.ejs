<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link rel="stylesheet" href="../styles/style.css" />

    <title>EHSYNC - Educação Online</title>
  </head>
  <body>
    <%- include('common/header'); %>

    <section class="hero">
      <div class="hero-container">
        <div class="container">
          <h1>Educação Online</h1>
          <p>
            Sua sala de aula
            <strong style="color: #4a78a6">disponível em qualquer lugar</strong>
          </p>
          <ul>
            <li> Cursos Profissionalizantes</li>
            <br />
            <li> Material didático</li>
            <br />
            <li> Interação com outros alunos</li>
          </ul>
          <br />
          <div class="buttons">
            <button style="background-color: #1b2232">Comece agora</button>
            <button style="background-color: #51769c">
              Conheça nossos cursos
            </button>
          </div>
        </div>
        <div class="hero-img">
          <img
            src="../src/estudante.png"
            alt="Estudante"
            width="500px"
            height="auto"
            object-fit="contain"
          />
        </div>
      </div>
      <h3>Se o mundo é online, sua carreira também pode ser. Vem com a EHS!</h3>
    </section>

    <section class="categories">
      <div class="category-buttons">
        <a onclick="filterCategory('tecnologia')">Tecnologia e Inovação</a>
        <a onclick="filterCategory('marketing')">Marketing Digital</a>
        <a onclick="filterCategory('empreendedorismo')">Empreendedorismo</a>
        <a onclick="filterCategory('softskills')">Soft Skills</a>
      </div>

      <div class="cards-area">
        <h1 style="color: #4a78a6">Tecnologia</h1>

        <div class="cards">

          <!-- Tecnologia -->
           <div class="card tecnologia">
            <% if (courses && courses.length > 0) { %>
    <% courses.forEach(course => { %>
      <div class="card <%= categoria.toLowerCase() %>">
        <div class="img" style="background-image: url('<%= course.imagem %>')"></div>
        <h3><%= course.nome %></h3>
        <p><%= course.descricao %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>Nenhum curso de <%= categoria %> encontrado.</p>
  <% } %>
  </div>
          <!-- Marketing -->
          <div class="card marketing">
            <div
              class="img"
              style="background-image: url('../src/cards/card-img5.jpg')"
            ></div>
            <h3>Marketing de Conteúdo</h3>
            <p>Criação de textos, SEO e engajamento.</p>
          </div>
          <div class="card marketing">
            <div
              class="img"
              style="background-image: url('../src/cards/card-img6.jpg')"
            ></div>
            <h3>Tráfego Pago</h3>
            <p>Facebook Ads, Google Ads, etc.</p>
          </div>

          <!-- Empreendedorismo -->
          <div class="card empreendedorismo">
            <div
              class="img"
              style="background-image: url('../src/cards/card-img7.jpg')"
            ></div>
            <h3>Criação de Negócios</h3>
            <p>Do zero ao seu próprio negócio digital.</p>
          </div>
          <div class="card empreendedorismo">
            <div
              class="img"
              style="background-image: url('../src/cards/card-img8.jpg')"
            ></div>
            <h3>Gestão Financeira</h3>
            <p>Controle de finanças para empreendedores.</p>
          </div>

          <!-- Soft Skills -->
          <div class="card softskills">
            <h3>Comunicação Eficaz</h3>
            <p>Como falar bem em público e no trabalho.</p>
          </div>
          <div class="card softskills">
            <h3>Liderança</h3>
            <p>Como liderar equipes e tomar decisões.</p>
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class="main">
        <h1>Explore nossas comunidades</h1>
        <div class="comunidades">
          <div class="big-container">
            <span class="docker">
              <div
                class="docker-header"
                style="background-image: url('../src/training3.jpg')"
              ></div>
              <div class="docker-body">
                <h3>Clube de desafios práticos</h3>
                <p>
                  Espaços interativos onde os alunos enfrentam desafios reais e
                  dinâmicos em suas áreas de estudo. A cada semana ou mês, novas
                  missões são lançadas para estimular a prática, desenvolver
                  habilidades e compartilhar soluções criativas com a
                  comunidade.
                </p>
                <button class="action-button">Ver comunidade</button>
              </div>
            </span>
          </div>
          <div class="small-container">
            <span class="docker">
              <div
                class="docker-header"
                style="background-image: url('../src/cursos/curso3.jpg')"
              ></div>
              <div class="docker-body">
                <h3>Clube de Carreira</h3>
                <p>
                  Ambientes dedicados ao crescimento profissional, onde alunos
                  recebem apoio de mentores, trocam experiências de mercado e
                  participam de sessões exclusivas de orientação de carreira,
                  networking e desenvolvimento pessoal.
                </p>
                <button class="action-button">Ver comunidade</button>
              </div>
            </span>
            <span class="docker">
              <div class="docker-body">
                <h3>Squad Learning</h3>
                <p>
                  Comunidades formadas por grupos pequenos ou duplas de estudo,
                  conectando alunos com interesses em comum para trocar
                  conhecimentos, manter a motivação e alcançar metas juntos de
                  forma mais leve e colaborativa.
                </p>
                <button class="action-button">Ver comunidade</button>
              </div>
              <div
                class="docker-header"
                style="background-image: url('../src/training.jpg')"
              ></div>
            </span>
          </div>
      </div>
    </section>
    <%- include('common/footer'); %>
    <script>
  /**
   * Fun o que filtra os cursos por categoria
   * @param {string} category - Categoria a ser filtrada
   * @returns {Promise<void>}
   */
      async function filterCategory(category) {
        const categories = ["Tecnologia", "Marketing", "Empreendedorismo", "Softskills"];
        document.querySelector('.cards-area h1').innerText = category.charAt(0).toUpperCase() + category.slice(1);
        categories.forEach(cat => {
          document.querySelectorAll(`.card.${cat.toLowerCase()}`).forEach(card => {
            card.style.display = cat.toLowerCase() === category ? 'block' : 'none';
          });
        });
        try{
          const res = await fetch(`/cursos/category/${category}`);
          const data = await res.json();
          console.log(data);
          if (data.length === 0) {
            document.querySelector('.cards-area .cards').innerHTML = '<h4 style="color: red; font-size: 20px; font-weight: 500; text-align: center;">Nenhum curso encontrado nessa categoria!</h4>';
          } else {
            const cardsArea = document.querySelector('.cards-area .cards');
            cardsArea.innerHTML = '';
            data.forEach(course => {
              const card = document.createElement('div');
              card.className = `card ${category}`;
              card.innerHTML = `
                <div class="img" style="background-image: url('${course.imagem}')"></div>
                <h3>${course.nome}</h3>
                <p>${course.descricao}</p>
              `;
              cardsArea.appendChild(card);
            });
          }
        } catch (error) {
          console.error(error);

        }
        
      };

      filterCategory("Tecnologia");


    </script>
  </body>
</html>

