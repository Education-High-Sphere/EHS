<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link rel="stylesheet" href="../styles/style.css" />

    <title>EHSYNC - Educação Online</title>
  </head>
  <body>
    <%- include('common/header'); %>

    <section class="hero">
      <div class="hero-container">
        <div class="container">
          <h1>Educação Online de Alta Performance</h1>
          <p>
            Sua sala de aula
            <span class="text-accent">disponível em qualquer lugar.</span>
          </p>
          <ul>
            <li>Cursos Profissionalizantes</li>
            <li>Material didático exclusivo</li>
            <li>Interação real com alunos e mentores</li>
          </ul>
          <div class="buttons">
            <button class="btn btn-primary btn-lg">Comece agora</button>
            <button class="btn btn-secondary btn-lg">Conheça os cursos</button>
          </div>
        </div>
        <div class="hero-img">
          <img
            src="../src/estudante.png"
            alt="Estudante EHS"
          />
        </div>
      </div>
      <h3 class="hero-footer-text">Se o mundo é online, sua carreira também pode ser. Vem com a EHS!</h3>
    </section>

    <section class="categories">
      <div class="category-buttons">
        <a onclick="filterCategory('tecnologia', this)" class="active">Tecnologia e Inovação</a>
        <a onclick="filterCategory('idiomas', this)">Idiomas</a>
        <a onclick="filterCategory('design & criação', this)">Design & Criação</a>
        <a onclick="filterCategory('negócios & finanças', this)">Negócios & Finanças</a>
      </div>

      <div class="cards-area">
        <h1>Tecnologia</h1>
        <div class="cards">
          <!-- Cards will be injected here -->
        </div>
      </div>
    </section>

    <section class="main">
      <h1>Explore nossas comunidades</h1>
      <div class="comunidades">
        <div class="big-container">
          <div class="docker">
            <div
              class="docker-header"
              style="background-image: url('../src/training3.jpg')"
            ></div>
            <div class="docker-body">
              <h3>Clube de desafios práticos</h3>
              <p>
                Espaços interativos onde os alunos enfrentam desafios reais e
                dinâmicos em suas áreas de estudo. A cada semana, novas
                missões são lançadas para estimular a prática e o networking.
              </p>
              <button class="btn btn-primary">Ver comunidade</button>
            </div>
          </div>
        </div>
        <div class="small-container">
          <div class="docker">
            <div
              class="docker-header"
              style="background-image: url('../src/cursos/curso3.jpg')"
            ></div>
            <div class="docker-body">
              <h3>Clube de Carreira</h3>
              <p>
                Ambientes dedicados ao crescimento profissional com mentores e networking.
              </p>
              <button class="btn btn-primary btn-sm">Ver comunidade</button>
            </div>
          </div>
          <div class="docker">
            <div
              class="docker-header"
              style="background-image: url('../src/training.jpg')"
            ></div>
            <div class="docker-body">
              <h3>Squad Learning</h3>
              <p>
                Grupos pequenos de estudo para troca de conhecimento e motivação mútua.
              </p>
              <button class="btn btn-primary btn-sm">Ver comunidade</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Corporate Section -->
    <section class="corporate-section">
      <div class="corporate-container">
        <div class="corporate-text">
          <h2>Soluções Corporativas EHSYNC</h2>
          <h3>Potencialize os talentos da sua empresa com trilhas personalizadas.</h3>
          <p>Desenvolvemos programas educacionais customizados, curadoria de temas e mentorias exclusivas para as equipes alcançarem a alta performance com acompanhamento metodológico B2B.</p>
          <ul class="corporate-benefits">
            <li><i class="fas fa-check-circle"></i> MAPEAMENTO DE DÉFICITS: Avaliamos onde sua equipe precisa crescer.</li>
            <li><i class="fas fa-check-circle"></i> TRILHAS EXCLUSIVAS: Cursos adaptados para a sua área.</li>
            <li><i class="fas fa-check-circle"></i> MENTORIA EHS: Acompanhamento de especialistas do mercado.</li>
          </ul>
          <button class="corporate-btn">Agendar Consultoria B2B</button>
        </div>
        <div class="corporate-image">
          <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=80" alt="Equipe em Treinamento Corporativo">
        </div>
      </div>
    </section>

    <%- include('common/footer'); %>

    <script>
      const allCourses = <%- JSON.stringify(courses || []) %>;

      async function filterCategory(categoryName, element){
        const cardsArea = document.querySelector(".cards-area .cards")
        const titleElement = document.querySelector(".cards-area h1")

        // Update active button
        if (element) {
          document.querySelectorAll('.category-buttons a').forEach(a => a.classList.remove('active'));
          element.classList.add('active');
        }

        titleElement.innerText = categoryName.charAt(0).toUpperCase() + categoryName.slice(1);
        cardsArea.innerHTML = "";

        const filteredCourses = allCourses.filter(
          (course) =>
          course.categoria.toLowerCase() === categoryName.toLowerCase() &&
          course.publicated
        );

        if (filteredCourses.length === 0) {
          cardsArea.innerHTML = '<h4 class="empty-state">Nenhum curso encontrado nesta categoria. Explore outras opções acima!</h4>';
        } else {
          filteredCourses.forEach((course) => {
            const card = document.createElement("div");
            card.className = `card`;
            
            const defaultPlaceholder = 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?w=600&q=80';
            
            card.innerHTML = `
              <div class="img" style="background-image: url('${defaultPlaceholder}'); background-color: #2a344a;"></div>
              <div class="card-content">
                <h3>${course.nome}</h3>
                <p>${course.descricao || 'Sem descrição disponível.'}</p>
              </div>
            `;

            // Verificação de imagem válida: Carrega o placeholder primeiro, e troca se a imagem real for válida
            if (course.imagem && course.imagem.trim() !== "") {
              const imgChecker = new Image();
              const imgDiv = card.querySelector('.img');
              imgChecker.onload = () => {
                if (imgDiv) imgDiv.style.backgroundImage = `url('${course.imagem}')`;
              };
              imgChecker.src = course.imagem;
            }

            card.onclick = () => {
              window.location.href = `/course/${course.id}`;
            };
            cardsArea.appendChild(card);
          });
        }
      }

      // Initial filter
      document.addEventListener('DOMContentLoaded', () => {
        filterCategory("tecnologia", document.querySelector('.category-buttons a.active'));
      });
    </script>
  </body>
</html>
