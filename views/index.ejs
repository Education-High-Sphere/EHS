<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link rel="stylesheet" href="../styles/style.css" />

    <title>EHSYNC - Educação Online</title>
  </head>
  <body>
    <%- include('common/header'); %>

    <section class="hero">
      <div class="hero-container">
        <div class="container">
          <h1>Educação Online</h1>
          <p>
            Sua sala de aula
            <strong style="color: #4a78a6">disponível em qualquer lugar</strong>
          </p>
          <ul>
            <li> Cursos Profissionalizantes</li>
            <br />
            <li> Material didático</li>
            <br />
            <li> Interação com outros alunos</li>
          </ul>
          <br />
          <div class="buttons">
            <button style="background-color: #1b2232">Comece agora</button>
            <button style="background-color: #51769c">
              Conheça nossos cursos
            </button>
          </div>
        </div>
        <div class="hero-img">
          <img
            src="../src/estudante.png"
            alt="Estudante"
            width="500px"
            height="auto"
            object-fit="contain"
          />
        </div>
      </div>
      <h3>Se o mundo é online, sua carreira também pode ser. Vem com a EHS!</h3>
    </section>

    <section class="categories">
      <div class="category-buttons">
        <a onclick="filterCategory('tecnologia')">Tecnologia e Inovação</a>
        <a onclick="filterCategory('idiomas')">Idiomas</a>
        <a onclick="filterCategory('design & criação')">Design & Criação</a>
        <a onclick="filterCategory('negócios & finanças')">Negócios & Finanças</a>
      </div>

      <div class="cards-area">
        <h1 style="color: #4a78a6">Tecnologia</h1>

        <div class="cards">
        </div>
      </div>
    </section>
    <section>
      <div class="main">
        <h1>Explore nossas comunidades</h1>
        <div class="comunidades">
          <div class="big-container">
            <span class="docker">
              <div
                class="docker-header"
                style="background-image: url('../src/training3.jpg')"
              ></div>
              <div class="docker-body">
                <h3>Clube de desafios práticos</h3>
                <p>
                  Espaços interativos onde os alunos enfrentam desafios reais e
                  dinâmicos em suas áreas de estudo. A cada semana ou mês, novas
                  missões são lançadas para estimular a prática, desenvolver
                  habilidades e compartilhar soluções criativas com a
                  comunidade.
                </p>
                <button class="action-button">Ver comunidade</button>
              </div>
            </span>
          </div>
          <div class="small-container">
            <span class="docker">
              <div
                class="docker-header"
                style="background-image: url('../src/cursos/curso3.jpg')"
              ></div>
              <div class="docker-body">
                <h3>Clube de Carreira</h3>
                <p>
                  Ambientes dedicados ao crescimento profissional, onde alunos
                  recebem apoio de mentores, trocam experiências de mercado e
                  participam de sessões exclusivas de orientação de carreira,
                  networking e desenvolvimento pessoal.
                </p>
                <button class="action-button">Ver comunidade</button>
              </div>
            </span>
            <span class="docker">
              <div class="docker-body">
                <h3>Squad Learning</h3>
                <p>
                  Comunidades formadas por grupos pequenos ou duplas de estudo,
                  conectando alunos com interesses em comum para trocar
                  conhecimentos, manter a motivação e alcançar metas juntos de
                  forma mais leve e colaborativa.
                </p>
                <button class="action-button">Ver comunidade</button>
              </div>
              <div
                class="docker-header"
                style="background-image: url('../src/training.jpg')"
              ></div>
            </span>
          </div>
      </div>
    </section>

    <!-- Corporate Section -->
    <section class="corporate-section">
      <div class="corporate-container">
        <div class="corporate-text">
          <h2>Soluções Corporativas EHSYNC</h2>
          <h3>Potencialize os talentos da sua empresa com trilhas personalizadas.</h3>
          <p>Desenvolvemos programas educacionais customizados, curadoria de temas e mentorias exclusivas para as equipes da sua empresa alcançarem a alta performance com acompanhamento metodológico B2B.</p>
          <ul class="corporate-benefits">
            <li><i class="fas fa-check-circle"></i> MAPEAMENTO DE DÉFICITS: Avaliamos onde sua equipe precisa crescer.</li>
            <li><i class="fas fa-check-circle"></i> TRILHAS EXCLUSIVAS: Cursos montados adaptados para a sua área.</li>
            <li><i class="fas fa-check-circle"></i> MENTORIA EHS: Acompanhamento de especialistas de ponta do mercado.</li>
          </ul>
          <button class="corporate-btn">Agendar Consultoria B2B</button>
        </div>
        <div class="corporate-image">
          <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=80" alt="Equipe em Treinamento Corporativo">
        </div>
      </div>
    </section>
    <%- include('common/footer'); %>
    <script>
      const allCourses = <%- JSON.stringify(courses || []) %>;

      async function filterCategory(categoryName){
        const cardsArea = document.querySelector(".cards-area .cards")
        const titleElement = document.querySelector(".cards-area h1")

        titleElement.innerText = categoryName.charAt(0).toUpperCase() + categoryName.slice(1);

        cardsArea.innerHTML = "";

        const filteredCourses = allCourses.filter(
          (course) =>
          course.categoria.toLowerCase() === categoryName.toLowerCase() &&
          course.publicated
        );

        if (filteredCourses.length === 0) {
    cardsArea.innerHTML =
      '<h4 class="empty" style="color: #4a78a6">Nenhum curso encontrado nessa categoria!</h4>';
  } else {
    filteredCourses.forEach((course) => {
      const card = document.createElement("div");
      
      // Usa a categoria correta do curso
      card.className = `card ${course.categoria.toLowerCase()}`;

      const placeholders = [
        'https://images.unsplash.com/photo-1516321497487-e288fb19713f?w=600&q=80',
        'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=600&q=80',
        'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&q=80',
        'https://images.unsplash.com/photo-1501504905252-473c47e087f8?w=600&q=80',
        'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&q=80',
        'https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=600&q=80'
      ];
      const phIndex = course.nome ? course.nome.length % placeholders.length : 0;
      const placeholderImg = placeholders[phIndex];
      const finalImg = course.imagem || placeholderImg;

      const imgDiv = document.createElement("div");
      imgDiv.className = "img";
      imgDiv.style.backgroundImage = `url('${finalImg}')`;

      // Validação de imagem funcional
      if (course.imagem) {
        const testImg = new Image();
        testImg.src = course.imagem;
        testImg.onerror = () => {
          imgDiv.style.backgroundImage = `url('${placeholderImg}')`;
        };
      }

      const title = document.createElement("h3");
      title.textContent = course.nome;

      const description = document.createElement("p");
      description.textContent = course.descricao;

      card.appendChild(imgDiv);
      card.appendChild(title);
      card.appendChild(description);
      card.onclick = () => {
        window.location.href = `/course/${course.id}`; // Redireciona para a página do curso
      };
      cardsArea.appendChild(card);
    });
  }
}

      filterCategory("tecnologia")
    </script>
  </body>
</html>

