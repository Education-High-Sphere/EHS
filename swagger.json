{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Cursos",
    "version": "1.0.0",
    "description": "API para gerenciar cursos e usuários"
  },
  "paths": {
    "/api/users/register": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Registrar novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário registrado com sucesso" }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginInput"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso" },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/api/users/edit": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Editar perfil do usuário (com avatar)",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UserEditInput"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Usuário atualizado com sucesso" }
        }
      }
    },
    "/api/users/profile/{id}": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Obter perfil do usuário por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "example": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "404": { "description": "Usuário não encontrado" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Listar todos os usuários",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserProfile"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/logout": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Logout do usuário",
        "responses": {
          "200": { "description": "Logout realizado com sucesso" }
        }
      }
    },

    "/api/cursos": {
      "get": {
        "tags": ["Cursos"],
        "summary": "Listar todos os cursos",
        "responses": {
          "200": {
            "description": "Lista de cursos retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Curso" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Cursos"],
        "summary": "Criar novo curso",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CursoInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Curso criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Curso" }
              }
            }
          }
        }
      }
    },
    "/api/cursos/{id}": {
      "get": {
        "tags": ["Cursos"],
        "summary": "Listar curso por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "example": 101 }
          }
        ],
        "responses": {
          "200": {
            "description": "Curso retornado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Curso" }
              }
            }
          },
          "404": { "description": "Curso não encontrado" }
        }
      },
      "put": {
        "tags": ["Cursos"],
        "summary": "Atualizar curso por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "example": 101 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CursoInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curso atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Curso" }
              }
            }
          },
          "404": { "description": "Curso não encontrado" }
        }
      },
      "delete": {
        "tags": ["Cursos"],
        "summary": "Deletar curso por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "example": 101 }
          }
        ],
        "responses": {
          "204": { "description": "Curso deletado com sucesso" },
          "404": { "description": "Curso não encontrado" }
        }
      }
    },
    "/api/cursos/category/{categoria}": {
      "get": {
        "tags": ["Cursos"],
        "summary": "Listar cursos por categoria",
        "parameters": [
          {
            "name": "categoria",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "programacao" }
          }
        ],
        "responses": {
          "200": {
            "description": "Cursos retornados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Curso" }
                }
              }
            }
          }
        }
      }
  },
  "/api/cursos/create": {
      "post": {
        "tags": ["Cursos"],
        "summary": "Criar novo curso (rota /create)",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/CursoInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Curso criado com sucesso" }
        }
      }
    },
    "/api/cursos/{id}/publish": {
      "put": {
        "tags": ["Cursos"],
        "summary": "Publicar ou despublicar curso por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "example": 101 }
          }
        ],
        "responses": {
          "200": { "description": "Status de publicação alterado com sucesso" },
          "404": { "description": "Curso não encontrado" }
        }
      }
    },
    "/api/matriculas": {
      "get": {
        "tags": ["Matriculas"],
        "summary": "Listar todas as matrículas",
        "responses": {
          "200": { "description": "Lista de matrículas retornada com sucesso" }
        }
      },
      "post": {
        "tags": ["Matriculas"],
        "summary": "Criar nova matrícula",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId", "courseId"],
                "properties": {
                  "userId": { "type": "integer", "example": 1 },
                  "courseId": { "type": "integer", "example": 101 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Matrícula criada com sucesso" }
        }
      }
    },
    "/api/matriculas/{matriculaId}": {
      "get": {
        "tags": ["Matriculas"],
        "summary": "Obter matrícula por ID",
        "parameters": [
          { "name": "matriculaId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Matrícula retornada com sucesso" },
          "404": { "description": "Matrícula não encontrada" }
        }
      },
      "patch": {
        "tags": ["Matriculas"],
        "summary": "Atualizar parcialmente uma matrícula",
        "parameters": [
          { "name": "matriculaId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "concluido": { "type": "boolean" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "Matrícula atualizada com sucesso" },
          "404": { "description": "Matrícula não encontrada" }
        }
      },
      "delete": {
        "tags": ["Matriculas"],
        "summary": "Deletar matrícula por ID",
        "parameters": [
          { "name": "matriculaId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Matrícula deletada com sucesso" },
          "404": { "description": "Matrícula não encontrada" }
        }
      }
    },
    "/api/matriculas/user/{userId}": {
      "get": {
        "tags": ["Matriculas"],
        "summary": "Obter matrículas por usuário",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Matrículas retornadas com sucesso" },
          "404": { "description": "Nenhuma matrícula encontrada para o usuário" }
        }
      }
    },
    "/api/matriculas/course/{courseId}": {
      "get": {
        "tags": ["Matriculas"],
        "summary": "Obter matrículas por curso",
        "parameters": [
          { "name": "courseId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Matrículas para o curso retornadas com sucesso" },
          "404": { "description": "Nenhuma matrícula encontrada para o curso" }
        }
      }
    },
    "/api/matriculas/user/{userId}/courses": {
      "get": {
        "tags": ["Matriculas"],
        "summary": "Obter cursos do usuário (concluídos e em andamento)",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Cursos do usuário retornados com sucesso" },
          "404": { "description": "Nenhum curso encontrado para o usuário" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Curso": {
        "type": "object",
        "required": ["id", "titulo", "descricao", "categoria", "duracaoHoras"],
        "properties": {
          "id": { "type": "integer", "example": 101 },
          "titulo": { "type": "string", "example": "Introdução ao Node.js" },
          "descricao": { "type": "string", "example": "Curso básico sobre Node.js para iniciantes" },
          "categoria": { "type": "string", "example": "programacao" },
          "duracaoHoras": { "type": "integer", "example": 20 }
        }
      },
      "CursoInput": {
        "type": "object",
        "required": ["titulo", "descricao", "categoria", "duracaoHoras"],
        "properties": {
          "titulo": { "type": "string", "example": "Introdução ao Node.js" },
          "descricao": { "type": "string", "example": "Curso básico sobre Node.js para iniciantes" },
          "categoria": { "type": "string", "example": "programacao" },
          "duracaoHoras": { "type": "integer", "example": 20 }
        }
      },
      "UserRegisterInput": {
        "type": "object",
        "required": ["nome", "email", "senha"],
        "properties": {
          "nome": { "type": "string", "example": "Maria Silva" },
          "email": { "type": "string", "format": "email", "example": "maria@example.com" },
          "senha": { "type": "string", "format": "password", "example": "senha123" }
        }
      },
      "UserLoginInput": {
        "type": "object",
        "required": ["email", "senha"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "maria@example.com" },
          "senha": { "type": "string", "format": "password", "example": "senha123" }
        }
      },
      "UserEditInput": {
        "type": "object",
        "properties": {
          "nome": { "type": "string", "example": "Maria Atualizada" },
          "avatar": { "type": "string", "format": "binary" }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nome": { "type": "string", "example": "Maria Silva" },
          "email": { "type": "string", "format": "email", "example": "maria@example.com" },
          "avatarUrl": { "type": "string", "example": "https://meusite.com/imagens/maria.jpg" }
        }
      }
      ,
      "Matricula": {
        "type": "object",
        "required": ["id", "userId", "curso_id", "concluido"],
        "properties": {
          "id": { "type": "integer", "example": 1001 },
          "userId": { "type": "integer", "example": 1 },
          "curso_id": { "type": "integer", "example": 101 },
          "dataMatricula": { "type": "string", "format": "date-time", "example": "2025-11-03T12:34:56Z" },
          "concluido": { "type": "boolean", "example": false }
        }
      },
      "MatriculaInput": {
        "type": "object",
        "required": ["userId", "courseId"],
        "properties": {
          "userId": { "type": "integer", "example": 1 },
          "courseId": { "type": "integer", "example": 101 }
        }
      },
      "CourseWithMatricula": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 101 },
          "titulo": { "type": "string", "example": "Introdução ao Node.js" },
          "descricao": { "type": "string", "example": "Curso básico sobre Node.js" },
          "matricula": { "$ref": "#/components/schemas/Matricula" }
        }
      }
    }
  }
}
