# Database (Legacy pg pool / Supabase Direct Access)
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres

# Supabase API (Modern supabase-js client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ROLE_KEY=your-service-role-key

# Security
JWT_SECRET=YourSuperSecretKeyHere_ChangeThis!
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# App Config
PORT=3000
BASE_URL=http://localhost:3000
